# ── App ───────────────────────────────────────────────────────────────────────
# Generate with: docker compose run --rm backend php artisan key:generate --show
APP_KEY=base64:CHANGE_ME

# Public URL of the application (used by Laravel for link generation)
APP_URL=http://localhost

# ── Database ──────────────────────────────────────────────────────────────────
DB_DATABASE=bandms
DB_USERNAME=bandms
DB_PASSWORD=secret

# ── Ports (host) ──────────────────────────────────────────────────────────────
# Port exposed on your host machine → maps to frontend container port 80
FRONTEND_PORT=80

# ── Mail ──────────────────────────────────────────────────────────────────────
# Defaults to "log" — emails are written to storage/logs/laravel.log.
# Set to "smtp" (or "ses", "mailgun", etc.) to actually send emails.
MAIL_MAILER=log
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Contact form ─────────────────────────────────────────────────────────────
# Email address that receives contact form submissions.
CONTACT_EMAIL=hello@skankingstorks.com

# ── Newsletter ────────────────────────────────────────────────────────────────
# Public URL of the frontend — used to build links in confirmation emails.
# Must match the port you actually browse on, or emailed links land on the wrong
# host: the public site runs on 4322 in dev, so use http://localhost:4322 there.
# In production set this to your actual domain, e.g. https://yourbandname.com
FRONTEND_URL=http://localhost

# Set to "false" to skip MX/DNS validation (useful for local dev with fake emails)
NEWSLETTER_VERIFY_MX=true

# ── Security ──────────────────────────────────────────────────────────────────
# Login attempts allowed per minute, per IP. Keep this low in production — it is
# what makes credential stuffing expensive. Raise it locally when running the E2E
# suite, which logs in repeatedly across Playwright workers sharing one IP.
LOGIN_RATE_LIMIT=10

# ── Public site — maps ────────────────────────────────────────────────────────
# CARTO basemap key for the concert maps. Request one at
# https://carto.com/basemaps/apikey — it is emailed straight back, needs no
# CARTO account, and is free to 5M tile requests a month.
#
# Leave it empty and the maps still render, but every tile is watermarked
# "API KEY REQUIRED" — CARTO answers unkeyed requests with a 200 and a valid
# PNG, so nothing else anywhere will report a problem.
#
# Baked into the site at build time, so changing it needs a rebuild of the web
# image, not just a restart. Public by design: it ships in the client JS.
PUBLIC_CARTO_KEY=
