---
/**
 * Legacy unlocalised /about.
 *
 * Kept so inbound links from before About became a module keep working.
 * Delegates to the section component rather than holding a second copy.
 */
import { getSiteConfig } from '@/lib/cms'
import AboutSection from '@/components/sections/AboutSection.astro'

const siteConfig = await getSiteConfig()
if (siteConfig.modules.about === false) return Astro.redirect('/404', 307)
---

<AboutSection lang="en" />
