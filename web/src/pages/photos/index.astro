---
/**
 * Legacy unlocalised /photos.
 *
 * Kept so inbound links from before the /[lang]/[section] routes keep working.
 * Delegates to the section component rather than holding a second copy.
 */
import { getSiteConfig } from '@/lib/cms'
import PhotosSection from '@/components/sections/PhotosSection.astro'

const siteConfig = await getSiteConfig()
if (siteConfig.modules.photos === false) return Astro.redirect('/404', 307)
---

<PhotosSection lang="en" />
