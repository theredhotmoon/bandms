---
/**
 * Legacy unlocalised /releases/{id}.
 *
 * Kept so inbound links from before the /[lang]/{section}/{slug} routes keep
 * working. Delegates to the same detail component rather than holding a second
 * copy — this file had drifted into its own pre-theme layout while the localised
 * route was ported, which is exactly what delegation prevents.
 */
import { getReleases, getSiteConfig, findRelease } from '@/lib/cms'
import { existingDetails, inEveryLocale } from '@/lib/existingDetails'
import type { Release } from '@/types/release'
import { getSlugMap } from '@/lib/slugs'
import { LOCALES } from '@/lib/locales'
import ReleaseDetail from '@/components/detail/ReleaseDetail.astro'

export async function getStaticPaths() {
  const releases = await getReleases('en')
  // The record is fetched here and handed to the page, never fetched again
  // there: one deleted in between is not built (lib/existingDetails.ts). In
  // every locale, like the localised route, so this page's hreflang twin
  // exists whenever it does; the find* memo makes those the same requests.
  // Module off: the page only redirects, so it needs no record and none is fetched.
  if ((await getSiteConfig()).modules.releases === false) return releases.map(r => ({ params: { id: String(r.id) } }))
  const found = await existingDetails(releases, r => inEveryLocale(LOCALES, l => findRelease(r.id, l)), { label: r => `release ${r.id}` })
  return found.map(({ item: r, detail }) => ({ params: { id: String(r.id) }, props: { release: detail.en } }))
}

const { id } = Astro.params
const { release } = Astro.props as { release: Release }

const siteConfig = await getSiteConfig()
if (siteConfig.modules.releases === false) return Astro.redirect('/404', 307)

// The Polish equivalent of THIS page, not the Polish list page, and resolved via
// the slug map rather than a literal '/pl/releases' -- which 404s the moment the
// Polish releases module carries a custom slug. `alternates` now feeds the real
// <link rel="alternate">, so a wrong entry here is a wrong hreflang, not merely
// a wrong footer link. The English row defaults to this page's own URL.
const slugMap = await getSlugMap()
const alternates = { pl: `/pl/${slugMap.pl.releases ?? 'releases'}/${id}` }
---

<ReleaseDetail lang="en" alternates={alternates} release={release} />
