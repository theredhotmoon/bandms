---
/**
 * Legacy unlocalised /releases.
 *
 * Kept so inbound links from before the /[lang]/[section] routes keep working.
 * Delegates to the same section component rather than holding a second copy of
 * the page — the duplication between these two entry points is how the Contact
 * page drifted out of sync with its localised twin.
 */
import { getSiteConfig } from '@/lib/cms'
import ReleasesSection from '@/components/sections/ReleasesSection.astro'

const siteConfig = await getSiteConfig()
if (siteConfig.modules.releases === false) return Astro.redirect('/404', 307)
---

<ReleasesSection lang="en" />
