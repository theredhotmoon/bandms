---
/**
 * Legacy unlocalised /concerts.
 *
 * Kept so inbound links from before the /[lang]/... routes keep working.
 * Delegates to the same section component as the localised route rather than
 * holding a second copy — this file had drifted into its own pre-theme layout
 * with its own hardcoded English, which is exactly what delegation prevents.
 */
import { getSiteConfig } from '@/lib/cms'
import { getSlugMap } from '@/lib/slugs'
import { LOCALES, DEFAULT_LOCALE } from '@/lib/locales'
import ConcertsSection from '@/components/sections/ConcertsSection.astro'

const siteConfig = await getSiteConfig()
if (siteConfig.modules.concerts === false) return Astro.redirect('/404', 307)

// The *other* locales' pages, resolved through the slug map so a custom
// Polish slug does not turn the hreflang row into a 404. The default locale
// is left out on purpose: this page's canonical is its own unlocalised URL,
// and an `en` alternate pointing at /en/… would disagree with it — the
// broken-cluster shape releases/[id].astro already avoids.
const slugMap = await getSlugMap()
const alternates = Object.fromEntries(LOCALES.filter(l => l !== DEFAULT_LOCALE).map(l => [l, `/${l}/${slugMap[l].concerts ?? 'concerts'}`]))
---

<ConcertsSection lang="en" alternates={alternates} />
