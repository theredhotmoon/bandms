---
/**
 * Legacy unlocalised /concerts/{slug}.
 *
 * Kept so inbound links from before the /[lang]/... routes keep working.
 * Delegates to the same detail component as the localised route rather than
 * holding a second copy — this file had drifted into its own pre-theme layout
 * with its own hardcoded English, which is exactly what delegation prevents.
 */
import { getConcerts, getSiteConfig } from '@/lib/cms'
import { getSlugMap } from '@/lib/slugs'
import { LOCALES, DEFAULT_LOCALE } from '@/lib/locales'
import ConcertDetail from '@/components/detail/ConcertDetail.astro'

export async function getStaticPaths() {
  const concerts = await getConcerts()
  // slug_en is what the localised route is built from; a concert without one
  // has no page anywhere, so it is skipped rather than emitted as
  // /concerts/undefined — which would abort the whole build.
  return concerts
    .filter(c => c.slug_en)
    .map(c => ({ params: { slug: c.slug_en }, props: { itemId: c.id } }))
}

const { slug } = Astro.params
const { itemId } = Astro.props as { itemId: number }

const siteConfig = await getSiteConfig()
if (siteConfig.modules.concerts === false) return Astro.redirect('/404', 307)

const slugMap = await getSlugMap()
const alternates = Object.fromEntries(LOCALES.filter(l => l !== DEFAULT_LOCALE).map(l => [l, `/${l}/${slugMap[l].concerts ?? 'concerts'}/${slug}`]))
---

<ConcertDetail lang="en" alternates={alternates} itemId={itemId} />
