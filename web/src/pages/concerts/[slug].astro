---
/**
 * Legacy unlocalised /concerts/{slug}.
 *
 * Kept so inbound links from before the /[lang]/... routes keep working.
 * Delegates to the same detail component as the localised route rather than
 * holding a second copy — this file had drifted into its own pre-theme layout
 * with its own hardcoded English, which is exactly what delegation prevents.
 */
import { getConcerts, getSiteConfig, findConcert } from '@/lib/cms'
import { existingDetails, inEveryLocale } from '@/lib/existingDetails'
import type { Concert } from '@/types/concert'
import { getSlugMap } from '@/lib/slugs'
import { LOCALES, DEFAULT_LOCALE } from '@/lib/locales'
import ConcertDetail from '@/components/detail/ConcertDetail.astro'

export async function getStaticPaths() {
  const concerts = await getConcerts()
  // `slug` is what the localised route is built from; a concert without one
  // has no page anywhere, so it is skipped rather than emitted as
  // /concerts/undefined — which would abort the whole build.
  // The record is fetched here and handed to the page, never fetched again
  // there: one deleted in between is not built (lib/existingDetails.ts). In
  // every locale, like the localised route, so this page's hreflang twin
  // exists whenever it does; the find* memo makes those the same requests.
  // Module off: the page only redirects, so it needs no record and none is fetched.
  const withSlug = concerts.filter(c => c.slug)
  if ((await getSiteConfig()).modules.concerts === false) return withSlug.map(c => ({ params: { slug: c.slug } }))
  const found = await existingDetails(withSlug, c => inEveryLocale(LOCALES, l => findConcert(c.id, l)), { label: c => `concert ${c.id}` })
  return found.map(({ item: c, detail }) => ({ params: { slug: c.slug }, props: { concert: detail.en } }))
}

const { slug } = Astro.params
const { concert } = Astro.props as { concert: Concert }

const siteConfig = await getSiteConfig()
if (siteConfig.modules.concerts === false) return Astro.redirect('/404', 307)

const slugMap = await getSlugMap()
const alternates = Object.fromEntries(LOCALES.filter(l => l !== DEFAULT_LOCALE).map(l => [l, `/${l}/${slugMap[l].concerts ?? 'concerts'}/${slug}`]))
---

<ConcertDetail lang="en" alternates={alternates} concert={concert} />
