---
/**
 * Legacy unlocalised /contact.
 *
 * Kept so inbound links from before the /[lang]/[section] routes keep working.
 * It delegates to the same section component rather than duplicating it — the
 * two files used to hold byte-identical copies of the whole page, which is how
 * they drifted apart in the first place.
 */
import { getSiteConfig } from '@/lib/cms'
import ContactSection from '@/components/sections/ContactSection.astro'

const siteConfig = await getSiteConfig()
if (siteConfig.modules.contact === false) return Astro.redirect('/404', 307)
---

<ContactSection lang="en" />
