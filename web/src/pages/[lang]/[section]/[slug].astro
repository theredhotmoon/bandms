---
import type { Locale } from '@/types/shared'
import { getSlugMap, LOCALES } from '@/lib/slugs'
import { DEFAULT_LOCALE, type Alternates } from '@/lib/locales'
import { postSlug } from '@/lib/i18n'
import { getConcerts, getAllPosts, getReleases, getShopItems, getSiteConfig, getMembers } from '@/lib/cms'

import ConcertDetail   from '@/components/detail/ConcertDetail.astro'
import PostDetail      from '@/components/detail/PostDetail.astro'
import ReleaseDetail   from '@/components/detail/ReleaseDetail.astro'
import MerchItemDetail from '@/components/detail/MerchItemDetail.astro'
import MemberDetail    from '@/components/detail/MemberDetail.astro'

export async function getStaticPaths() {
  // One config, not one per locale: `modules` is the enabled map, which the API
  // builds without consulting ?lang=. Fetching it per locale was two requests
  // for the same answer.
  const [slugMap, cfg, concerts, posts, releases, shopItems, members] = await Promise.all([
    getSlugMap(),
    getSiteConfig(DEFAULT_LOCALE),
    getConcerts(),
    getAllPosts('en'),
    getReleases('en'),
    getShopItems(),
    getMembers(DEFAULT_LOCALE),
  ])

  const paths: object[] = []

  // Every locale's path for one item. `slug` is either the same string in every
  // locale (concerts and merch on their default-locale `slug` — there is no per-locale slug on those
  // public routes) or a per-locale resolver (posts — postSlug() walks the
  // locale's fallback chain over translations.slug, so /pl/ serves the Polish
  // slug and falls back to the English one).
  const alternatesFor = (section: string, slug: string | number | ((lang: Locale) => string)) =>
    Object.fromEntries(
      LOCALES.map(l => [l, `/${l}/${slugMap[l][section] ?? section}/${typeof slug === 'function' ? slug(l) : slug}`]),
    ) as Alternates

  for (const lang of LOCALES) {

    if (cfg.modules.concerts !== false) {
      for (const c of concerts) {
        paths.push({
          params: { lang, section: slugMap[lang].concerts ?? 'concerts', slug: c.slug },
          props: { sectionType: 'concerts', lang, itemId: c.id, itemSlug: c.slug,
            alternates: alternatesFor('concerts', c.slug) },
        })
      }
    }

    if (cfg.modules.posts !== false) {
      for (const p of posts) {
        const slug = postSlug(p, lang)
        paths.push({
          params: { lang, section: slugMap[lang].posts ?? 'posts', slug },
          props: { sectionType: 'posts', lang, itemId: p.id, itemSlug: slug,
            alternates: alternatesFor('posts', l => postSlug(p, l)) },
        })
      }
    }

    if (cfg.modules.releases !== false) {
      for (const r of releases) {
        paths.push({
          params: { lang, section: slugMap[lang].releases ?? 'releases', slug: String(r.id) },
          props: { sectionType: 'releases', lang, itemId: r.id, itemSlug: '',
            alternates: alternatesFor('releases', r.id) },
        })
      }
    }

    // Member pages live under About and go with it — and with its Members
    // section: a band that hides that section should not still publish a page
    // per member. A member with no slug (an API predating it) gets no page
    // rather than an /about/undefined one.
    if (cfg.modules.about !== false && cfg.module_config?.about?.visibility?.show_members !== false) {
      for (const m of members.filter(m => m.slug)) {
        paths.push({
          params: { lang, section: slugMap[lang].about ?? 'about', slug: m.slug },
          props: { sectionType: 'about', lang, itemId: m.id, itemSlug: m.slug,
            alternates: alternatesFor('about', m.slug) },
        })
      }
    }
    if (cfg.modules.merch !== false) {
      for (const item of shopItems) {
        paths.push({
          params: { lang, section: slugMap[lang].merch ?? 'merch', slug: item.slug },
          props: { sectionType: 'merch', lang, itemId: 0, itemSlug: item.slug,
            alternates: alternatesFor('merch', item.slug) },
        })
      }
    }
  }

  return paths
}

interface Props {
  sectionType: string
  lang: Locale
  alternates: Alternates
  itemId: number
  itemSlug: string
}

const { sectionType, lang, alternates, itemId, itemSlug } = Astro.props
---

{sectionType === 'concerts'  && <ConcertDetail   lang={lang} alternates={alternates} itemId={itemId} />}
{sectionType === 'posts'     && <PostDetail      lang={lang} alternates={alternates} itemId={itemId} />}
{sectionType === 'releases'  && <ReleaseDetail   lang={lang} alternates={alternates} itemId={itemId} />}
{sectionType === 'merch'     && <MerchItemDetail lang={lang} alternates={alternates} itemSlug={itemSlug} />}
{sectionType === 'about'     && <MemberDetail    lang={lang} alternates={alternates} itemId={itemId} />}
