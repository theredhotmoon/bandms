---
/**
 * The privacy policy. Reserves the `privacy` segment as a fixed route, the
 * same category as the existing fixed `/rider` and `/epk` routes; its copy is
 * the `privacy` website_modules row, a fixed-route module like `home`.
 */
import type { Locale } from '@/types/shared'
import { LOCALES, type Alternates } from '@/lib/locales'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getBandProfile, getSiteConfig } from '@/lib/cms'
import { PRIVACY_COPY, fillCopy } from '@bandms/site-copy'
import { moduleCopy } from '@/lib/copy'

export async function getStaticPaths() {
  return LOCALES.map(lang => ({ params: { lang } }))
}

const { lang } = Astro.params as { lang: Locale }
const alternates = Object.fromEntries(LOCALES.map(l => [l, `/${l}/privacy`])) as Alternates

const profile = await getBandProfile(lang).catch(() => null)
const bandName = profile?.name ?? 'this site'
const contactEmail = profile?.booking_email

// Every string on this page is editable in Website Modules → Privacy, which
// also holds the cookie banner's copy. {band} and {email} are filled in here.
const c = moduleCopy(await getSiteConfig(lang), 'privacy', PRIVACY_COPY, lang)
const t = {
  ...c,
  intro: fillCopy(c.intro, { band: bandName }),
  controllerBody: contactEmail ? fillCopy(c.controllerBody, { email: contactEmail }) : c.controllerBodyNoEmail,
}
---

<BaseLayout lang={lang} alternates={alternates} title={t.title} description={t.description}>
  <div class="mx-auto max-w-2xl px-4 sm:px-6 pt-16 pb-24">
    <h1 class="text-3xl font-black text-body sm:text-4xl leading-tight">{t.title}</h1>

    <div class="prose mt-6">
      <p>{t.intro}</p>

      <h2>{t.cookiesHeading}</h2>
      <p>{t.cookiesBody}</p>
      <ul>
        <li><strong>{t.cookieName}:</strong> {t.cookieNameValue}</li>
        <li><strong>{t.cookiePurpose}:</strong> {t.cookiePurposeValue}</li>
        <li><strong>{t.cookieDuration}:</strong> {t.cookieDurationValue}</li>
      </ul>

      <h2>{t.withdrawHeading}</h2>
      <p>{t.withdrawBody}</p>

      <h2>{t.controllerHeading}</h2>
      <p>{t.controllerBody}</p>

      <h2>{t.googleHeading}</h2>
      <p>
        {t.googleBody}
        {' '}<a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">{t.googleLinkLabel}</a>
      </p>
    </div>
  </div>
</BaseLayout>
