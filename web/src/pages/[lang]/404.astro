---
/**
 * The not-found page, one per locale. nginx serves it for any 404 — by URL
 * prefix when the miss is under /en/ or /pl/, and by Accept-Language for an
 * unprefixed one — see the error_page blocks in web/docker/nginx.conf. It is
 * a normal built route only because Astro can emit a single root 404.html;
 * nginx marks the built paths `internal`, so a direct request for /en/404/ is
 * itself a 404 rather than a 200 for a page that says "not found".
 *
 * Copy is editable like every other public string — it lives on the `site`
 * website_modules row, since a 404 belongs to no page.
 */
import type { Locale } from '@/types/shared'
import { LOCALES } from '@/lib/locales'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getSiteConfig } from '@/lib/cms'
import { siteCopy } from '@/lib/copy'

export async function getStaticPaths() {
  return LOCALES.map(lang => ({ params: { lang } }))
}

const { lang } = Astro.params as { lang: Locale }

// Copy comes from the site-wide row (Website Modules → Site-wide → 404 page).
const site = siteCopy(await getSiteConfig(lang), lang)
const t = { title: site.notFoundTitle, description: site.notFoundDescription, body: site.notFoundBody, home: site.notFoundHome }
---

<BaseLayout lang={lang} title={t.title} description={t.description} noindex={true}>
  <div class="mx-auto max-w-lg px-4 sm:px-6 py-32 text-center">
    <p class="text-8xl font-black text-subtle">404</p>
    <h1 class="mt-4 text-2xl font-black text-body">{t.title}</h1>
    <p class="mt-2 text-muted">{t.body}</p>
    <a href={`/${lang}/`} class="mt-8 inline-block rounded-card bg-accent px-6 py-3 font-bold text-on-accent hover:bg-accent-dark transition-colors">
      {t.home}
    </a>
  </div>
</BaseLayout>
