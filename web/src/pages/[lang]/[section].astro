---
import type { Locale } from '@/types/shared'
import { getSlugMap, LOCALES } from '@/lib/slugs'
import { DEFAULT_LOCALE, type Alternates } from '@/lib/locales'
import { getSiteConfig } from '@/lib/cms'

import ConcertsSection   from '@/components/sections/ConcertsSection.astro'
import ReleasesSection   from '@/components/sections/ReleasesSection.astro'
import PostsSection      from '@/components/sections/PostsSection.astro'
import PhotosSection     from '@/components/sections/PhotosSection.astro'
import VideosSection     from '@/components/sections/VideosSection.astro'
import PressSection      from '@/components/sections/PressSection.astro'
import MerchSection      from '@/components/sections/MerchSection.astro'
import EpkSection        from '@/components/sections/EpkSection.astro'
import ContactSection    from '@/components/sections/ContactSection.astro'
import AboutSection      from '@/components/sections/AboutSection.astro'
import NewsletterSection from '@/components/sections/NewsletterSection.astro'

export async function getStaticPaths() {
  const LIST_ONLY_SECTIONS = ['photos', 'videos', 'press', 'epk', 'contact', 'newsletter', 'about'] as const
  const DETAIL_SECTIONS    = ['concerts', 'releases', 'posts', 'merch'] as const
  const ALL_SECTIONS       = [...LIST_ONLY_SECTIONS, ...DETAIL_SECTIONS] as const
  const ALWAYS_ON          = new Set(['newsletter'])

  // One config, not one per locale: `modules` is the enabled map, which the API
  // builds without consulting ?lang=. Fetching it per locale was two requests
  // for the same answer.
  const [slugMap, cfg] = await Promise.all([
    getSlugMap(),
    getSiteConfig(DEFAULT_LOCALE),
  ])

  // Every locale's path for one section, keyed by locale. Built once per
  // section rather than per (locale, section) pair: the map is the same
  // whichever locale is being rendered.
  const alternatesFor = (section: string) =>
    Object.fromEntries(
      LOCALES.map(l => [l, `/${l}/${slugMap[l][section] ?? section}`]),
    ) as Alternates

  return LOCALES.flatMap(lang => {
    return ALL_SECTIONS
      .filter(sectionType => ALWAYS_ON.has(sectionType) || cfg.modules[sectionType] !== false)
      .map(sectionType => ({
        params: {
          lang,
          section: slugMap[lang][sectionType] ?? sectionType,
        },
        props: {
          sectionType,
          lang,
          alternates: alternatesFor(sectionType),
        },
      }))
  })
}

interface Props {
  sectionType: string
  lang: Locale
  alternates: Alternates
}

const { sectionType, lang, alternates } = Astro.props
---

{sectionType === 'concerts'   && <ConcertsSection   lang={lang} alternates={alternates} />}
{sectionType === 'releases'   && <ReleasesSection   lang={lang} alternates={alternates} />}
{sectionType === 'posts'      && <PostsSection      lang={lang} alternates={alternates} />}
{sectionType === 'photos'     && <PhotosSection     lang={lang} alternates={alternates} />}
{sectionType === 'videos'     && <VideosSection     lang={lang} alternates={alternates} />}
{sectionType === 'press'      && <PressSection      lang={lang} alternates={alternates} />}
{sectionType === 'merch'      && <MerchSection      lang={lang} alternates={alternates} />}
{sectionType === 'epk'        && <EpkSection        lang={lang} alternates={alternates} />}
{sectionType === 'contact'    && <ContactSection    lang={lang} alternates={alternates} />}
{sectionType === 'about'      && <AboutSection      lang={lang} alternates={alternates} />}
{sectionType === 'newsletter' && <NewsletterSection lang={lang} alternates={alternates} />}
