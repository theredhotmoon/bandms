---
// Stripe's cancel_url. Nothing was charged and the cart is deliberately left
// intact, so "Return to cart" resumes exactly where the customer left off.
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getSiteConfig } from '@/lib/cms'
import { getSlugMap } from '@/lib/slugs'
import { merchCopy } from '@/lib/copy'

// Unlocalised route (Stripe's cancel_url), so it reads the default locale's
// copy from the Merch module.
const [siteConfig, slugMap] = await Promise.all([getSiteConfig('en'), getSlugMap()])
const t = merchCopy(siteConfig, 'en')
const merchHref = `/en/${slugMap.en.merch ?? 'merch'}`
---

<BaseLayout title={t.cancelTitle} description={t.cancelBody} noindex={true}>
  <div class="mx-auto max-w-2xl px-4 sm:px-6 pt-16 pb-24">
    <div class="rounded-card border border-border bg-surface p-8 sm:p-10">
      <h1 class="text-2xl font-black text-body sm:text-3xl">{t.cancelTitle}</h1>
      <p class="mt-3 text-muted">{t.cancelBody}</p>
      <a href={merchHref} class="mt-8 inline-block text-sm text-accent hover:underline">{t.backToMerch}</a>
    </div>
  </div>
</BaseLayout>
