---
/**
 * Legacy unlocalised /merch.
 *
 * Kept so inbound links from before the /[lang]/... routes keep working.
 * Delegates to the same section component as the localised route rather than
 * holding a second copy — this file had drifted into its own pre-theme layout
 * with its own hardcoded English, which is exactly what delegation prevents.
 */
import { getSiteConfig } from '@/lib/cms'
import { getSlugMap } from '@/lib/slugs'
import { LOCALES } from '@/lib/locales'
import MerchSection from '@/components/sections/MerchSection.astro'

const siteConfig = await getSiteConfig()
if (siteConfig.modules.merch === false) return Astro.redirect('/404', 307)

// Every locale's own list page, resolved through the slug map so a custom
// Polish slug does not turn the hreflang row into a 404.
const slugMap = await getSlugMap()
const alternates = Object.fromEntries(LOCALES.map(l => [l, `/${l}/${slugMap[l].merch ?? 'merch'}`]))
---

<MerchSection lang="en" alternates={alternates} />
