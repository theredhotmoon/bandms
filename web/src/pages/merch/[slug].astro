---
/**
 * Legacy unlocalised /merch/{slug}.
 *
 * Kept so inbound links from before the /[lang]/... routes keep working.
 * Delegates to the same detail component as the localised route rather than
 * holding a second copy — this file had drifted into its own pre-theme layout
 * with its own hardcoded English, which is exactly what delegation prevents.
 */
import { getShopItems, getSiteConfig } from '@/lib/cms'
import { getSlugMap } from '@/lib/slugs'
import { LOCALES } from '@/lib/locales'
import MerchItemDetail from '@/components/detail/MerchItemDetail.astro'

export async function getStaticPaths() {
  const items = await getShopItems()
  // slug_en is NOT NULL UNIQUE, so the filter is insurance: a missing param
  // here costs the whole build, not one page.
  return items
    .filter(i => i.slug_en)
    .map(i => ({ params: { slug: i.slug_en } }))
}

const { slug } = Astro.params

const siteConfig = await getSiteConfig()
if (siteConfig.modules.merch === false) return Astro.redirect('/404', 307)

const slugMap = await getSlugMap()
const alternates = Object.fromEntries(LOCALES.map(l => [l, `/${l}/${slugMap[l].merch ?? 'merch'}/${slug}`]))
---

<MerchItemDetail lang="en" alternates={alternates} itemSlug={slug!} />
