---
/**
 * Legacy unlocalised /merch/{slug}.
 *
 * Kept so inbound links from before the /[lang]/... routes keep working.
 * Delegates to the same detail component as the localised route rather than
 * holding a second copy — this file had drifted into its own pre-theme layout
 * with its own hardcoded English, which is exactly what delegation prevents.
 */
import { getShopItems, getSiteConfig, findShopItem } from '@/lib/cms'
import { existingDetails, inEveryLocale } from '@/lib/existingDetails'
import type { ShopItem } from '@/types/shop'
import { getSlugMap } from '@/lib/slugs'
import { LOCALES, DEFAULT_LOCALE } from '@/lib/locales'
import MerchItemDetail from '@/components/detail/MerchItemDetail.astro'

export async function getStaticPaths() {
  const items = await getShopItems()
  // `slug` is always set (the default locale's), so the filter is insurance: a missing param
  // here costs the whole build, not one page.
  // The record is fetched here and handed to the page, never fetched again
  // there: one deleted in between is not built (lib/existingDetails.ts). In
  // every locale, like the localised route, so this page's hreflang twin
  // exists whenever it does; the find* memo makes those the same requests.
  // Module off: the page only redirects, so it needs no record and none is fetched.
  const withSlug = items.filter(i => i.slug)
  if ((await getSiteConfig()).modules.merch === false) return withSlug.map(i => ({ params: { slug: i.slug } }))
  const found = await existingDetails(withSlug, i => inEveryLocale(LOCALES, l => findShopItem(i.slug, l)), { label: i => `shop item ${i.slug}` })
  return found.map(({ item: i, detail }) => ({ params: { slug: i.slug }, props: { item: detail.en } }))
}

const { slug } = Astro.params
const { item } = Astro.props as { item: ShopItem }

const siteConfig = await getSiteConfig()
if (siteConfig.modules.merch === false) return Astro.redirect('/404', 307)

const slugMap = await getSlugMap()
const alternates = Object.fromEntries(LOCALES.filter(l => l !== DEFAULT_LOCALE).map(l => [l, `/${l}/${slugMap[l].merch ?? 'merch'}/${slug}`]))
---

<MerchItemDetail lang="en" alternates={alternates} item={item} />
