---
/**
 * Legacy unlocalised /press.
 *
 * Kept so inbound links from before the /[lang]/... routes keep working.
 * Delegates to the same section component as the localised route rather than
 * holding a second copy — this file had drifted into its own pre-theme layout
 * with its own hardcoded English, which is exactly what delegation prevents.
 */
import { getSiteConfig } from '@/lib/cms'
import { getSlugMap, sectionAlternates } from '@/lib/slugs'
import PressSection from '@/components/sections/PressSection.astro'

const siteConfig = await getSiteConfig()
if (siteConfig.modules.press === false) return Astro.redirect('/404', 307)

// Every locale's path, /en/ included: that one is this page's canonical.
const alternates = sectionAlternates(await getSlugMap(), 'press')
---

<PressSection lang="en" alternates={alternates} />
