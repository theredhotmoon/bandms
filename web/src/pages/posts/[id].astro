---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getPosts, getPost, getBandProfile, getSiteConfig } from '@/lib/cms'
import { getSlugMap } from '@/lib/slugs'
import { fmtDate } from '@/lib/i18n'
import PostBlocks from '@/components/blocks/PostBlocks.astro'

export async function getStaticPaths() {
  const { data: posts } = await getPosts('en', 1)
  return posts.map(p => ({ params: { id: String(p.id) } }))
}

const { id } = Astro.params
const [post, profile, slugMap, siteConfig] = await Promise.all([
  getPost(Number(id), 'en'),
  getBandProfile('en'),
  getSlugMap(),
  getSiteConfig('en'),
])

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.intro ?? post.excerpt,
  image: post.image ?? undefined,
  datePublished: post.published_at ?? post.created_at,
  author: { '@type': 'Organization', name: profile.name },
  publisher: { '@type': 'Organization', name: profile.name },
  url: Astro.url.href,
}
---

<BaseLayout
  title={`${post.title} — ${profile.name}`}
  description={post.intro ?? post.excerpt}
  image={post.image}
  structuredData={structuredData}
>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 pt-16 pb-24">
    <nav class="mb-8 text-sm text-subtle">
      <a href="/posts" class="hover:text-muted transition-colors">News</a>
      <span class="mx-2">›</span>
      <span class="text-muted line-clamp-1">{post.title}</span>
    </nav>

    {/* Tags */}
    {post.tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-4">
        {post.tags.map(tag => (
          <span class="rounded-pill bg-surface-2 px-3 py-0.5 text-xs text-muted">{tag.name}</span>
        ))}
      </div>
    )}

    <h1 class="text-3xl font-black text-body sm:text-4xl leading-tight">{post.title}</h1>

    {post.intro && (
      <p class="mt-4 text-lg text-muted leading-relaxed">{post.intro}</p>
    )}

    <time class="mt-3 block text-sm text-subtle" datetime={post.published_at ?? post.created_at}>
      {fmtDate(post.published_at ?? post.created_at, 'en')}
    </time>

    {/* Cover image */}
    {post.image && (
      <div class="mt-8 overflow-hidden rounded-card border border-border">
        <img src={post.image} alt={post.title} loading="eager" class="w-full object-cover" />
      </div>
    )}

    {/* Content blocks */}
    <div class="mt-8">
      <PostBlocks
        blocks={post.blocks ?? []}
        lang="en"
        slugMap={slugMap}
        modules={siteConfig.modules ?? {}}
      />
    </div>
  </div>
</BaseLayout>
