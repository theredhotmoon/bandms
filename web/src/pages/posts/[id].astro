---
/**
 * Legacy unlocalised /posts/{id}.
 *
 * Kept so inbound links from before the /[lang]/... routes keep working.
 * Delegates to the same detail component as the localised route rather than
 * holding a second copy — this file had drifted into its own pre-theme layout
 * with its own hardcoded English, which is exactly what delegation prevents.
 */
import { getAllPosts, getSiteConfig } from '@/lib/cms'
import { getSlugMap } from '@/lib/slugs'
import { LOCALES } from '@/lib/locales'
import { postSlug } from '@/lib/i18n'
import PostDetail from '@/components/detail/PostDetail.astro'

export async function getStaticPaths() {
  const posts = await getAllPosts('en')
  return posts.map(p => ({ params: { id: String(p.id) }, props: { post: p } }))
}

const { post } = Astro.props as { post: Awaited<ReturnType<typeof getAllPosts>>[number] }

const siteConfig = await getSiteConfig()
if (siteConfig.modules.posts === false) return Astro.redirect('/404', 307)

// The localised routes key posts by their per-locale slug, not by id.
const slugMap = await getSlugMap()
const alternates = Object.fromEntries(LOCALES.map(l => [l, `/${l}/${slugMap[l].posts ?? 'posts'}/${postSlug(post, l)}`]))
---

<PostDetail lang="en" alternates={alternates} itemId={post.id} />
