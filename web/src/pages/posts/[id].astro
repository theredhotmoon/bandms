---
/**
 * Legacy unlocalised /posts/{id}.
 *
 * Kept so inbound links from before the /[lang]/... routes keep working.
 * Delegates to the same detail component as the localised route rather than
 * holding a second copy — this file had drifted into its own pre-theme layout
 * with its own hardcoded English, which is exactly what delegation prevents.
 */
import { getAllPosts, getSiteConfig, findPost } from '@/lib/cms'
import { existingDetails, inEveryLocale } from '@/lib/existingDetails'
import type { Post } from '@/types/post'
import { getSlugMap } from '@/lib/slugs'
import { LOCALES, DEFAULT_LOCALE } from '@/lib/locales'
import { postSlug } from '@/lib/i18n'
import PostDetail from '@/components/detail/PostDetail.astro'

export async function getStaticPaths() {
  const posts = await getAllPosts('en')
  // The record is fetched here and handed to the page, never fetched again
  // there: one deleted in between is not built (lib/existingDetails.ts). In
  // every locale, like the localised route, so this page's hreflang twin
  // exists whenever it does; the find* memo makes those the same requests.
  // Module off: the page only redirects, so it needs no record and none is fetched.
  if ((await getSiteConfig()).modules.posts === false) return posts.map(p => ({ params: { id: String(p.id) } }))
  const found = await existingDetails(posts, p => inEveryLocale(LOCALES, l => findPost(p.id, l)), { label: p => `post ${p.id}` })
  return found.map(({ item: p, detail }) => ({ params: { id: String(p.id) }, props: { post: detail.en } }))
}

const { post } = Astro.props as { post: Post }

const siteConfig = await getSiteConfig()
if (siteConfig.modules.posts === false) return Astro.redirect('/404', 307)

// The localised routes key posts by their per-locale slug, not by id.
const slugMap = await getSlugMap()
const alternates = Object.fromEntries(LOCALES.filter(l => l !== DEFAULT_LOCALE).map(l => [l, `/${l}/${slugMap[l].posts ?? 'posts'}/${postSlug(post, l)}`]))
---

<PostDetail lang="en" alternates={alternates} post={post} />
