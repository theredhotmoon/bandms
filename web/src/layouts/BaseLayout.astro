---
import type { Locale } from '@/types/shared'
import BaseHead from '@/components/BaseHead.astro'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import CartDrawer from '@/components/CartDrawer.vue'
import { getTheme, THEME_FONTS } from '@/lib/theme'
import ThemeSlot from '@/components/ThemeSlot.astro'
import '@/styles/global.css'

export interface Props {
  title: string
  description: string
  image?: string | null
  canonical?: string
  noindex?: boolean
  structuredData?: object
  bandName?: string
  lang?: Locale
  alternateHref?: string
}

const {
  title,
  description,
  image,
  canonical,
  noindex,
  structuredData,
  bandName = 'Skanking Storks',
  lang = 'en',
  alternateHref,
} = Astro.props

const pageTitle = title === bandName ? title : `${title} — ${bandName}`

// Theme is an attribute rather than a build flag: every theme's tokens ship in
// one stylesheet scoped to [data-theme], so switching is a runtime concern the
// CMS can drive later without a rebuild.
const theme = await getTheme(lang)
const fontHref = THEME_FONTS[theme]
---

<!doctype html>
<html lang={lang} data-theme={theme}>
  <head>
    {fontHref && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href={fontHref} />
      </>
    )}
    <BaseHead
      title={pageTitle}
      description={description}
      image={image}
      canonical={canonical}
      noindex={noindex}
      structuredData={structuredData}
    />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header lang={lang} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} alternateHref={alternateHref} />
    <CartDrawer client:idle />
    <ThemeSlot name="page-grain" />
  </body>
</html>
