---
import type { Locale } from '@/types/shared'
import type { Alternates } from '@/lib/locales'
import BaseHead from '@/components/BaseHead.astro'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import CartDrawer from '@/components/CartDrawer.vue'
import ConsentBanner from '@/components/ConsentBanner.vue'
import { getTheme, THEME_FONTS } from '@/lib/theme'
import { contentWidthFor } from '@/lib/contentWidth'
import { getBandProfile, getSiteConfig } from '@/lib/cms'
import { PRIVACY_COPY } from '@bandms/site-copy'
import { cartCopy, merchCopy, moduleCopy, siteCopy } from '@/lib/copy'
import ThemeSlot from '@/components/ThemeSlot.astro'
import '@/styles/global.css'

// Unset means the banner and GA never render — same fail-open shape as
// PUBLIC_CARTO_KEY (see web/src/lib/basemap.ts).
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || ''

export interface Props {
  title: string
  description: string
  image?: string | null
  canonical?: string
  noindex?: boolean
  structuredData?: object
  lang?: Locale
  alternates?: Alternates
  /**
   * The website module this page belongs to — a detail page passes its
   * parent's key. Decides the content width set in the admin; omitted means
   * full width.
   */
  module?: string
}

const {
  title,
  description,
  image,
  canonical,
  noindex,
  structuredData,
  lang = 'en',
  alternates = {},
  module,
} = Astro.props

// The layout is the only thing that appends the band name to a <title>. Pass
// the page's own heading and nothing more — a caller that adds the name itself
// gets it twice, which is how every section page shipped as
// "News — Skanking Storks — Skanking Storks" from July to September 2026.
// The name comes from the profile, not a literal: a `bandName` prop with a
// hardcoded default used to sit here, nobody passed it, and it only looked
// right for the one band whose name happened to match. Fail-open like Footer,
// so an unreachable API costs the suffix rather than the build.
const [profile, siteConfig] = await Promise.all([
  getBandProfile(lang).catch(() => null),
  getSiteConfig(lang),
])

// The cart drawer and cookie banner are mounted here on every page, so their
// copy is read here too — from the merch and privacy rows respectively.
const cart = cartCopy(merchCopy(siteConfig, lang))
const privacy = moduleCopy(siteConfig, 'privacy', PRIVACY_COPY, lang)
const site = siteCopy(siteConfig, lang)
const bannerCopy = { body: privacy.bannerBody, accept: privacy.bannerAccept, reject: privacy.bannerReject, privacy: privacy.bannerLink }
// With the privacy row switched off its page is not built, so the banner
// must not link to it — same "gate on the module map" rule as every other link.
const privacyHref = siteConfig.modules.privacy !== false ? `/${lang}/privacy` : null
const bandName = profile?.name?.trim() || ''
const pageTitle = !bandName || title === bandName ? title : `${title} — ${bandName}`

// Theme is an attribute rather than a build flag: every theme's tokens ship in
// one stylesheet scoped to [data-theme], so switching is a runtime concern the
// CMS can drive later without a rebuild.
const theme = await getTheme(lang)
const fontHref = THEME_FONTS[theme]

// Read by .page-content in base.css, which every section's content box uses.
const contentWidth = contentWidthFor(siteConfig, module)
---

<!doctype html>
<html lang={lang} data-theme={theme}>
  <head>
    {fontHref && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href={fontHref} />
      </>
    )}
    <BaseHead
      lang={lang}
      alternates={alternates}
      title={pageTitle}
      description={description}
      image={image}
      canonical={canonical}
      noindex={noindex}
      structuredData={structuredData}
      siteName={bandName}
    />
    <slot name="head" />
    <!-- Marks a page that runs JS, before first paint. Items per page hides
         held-back items only under .js (base.css): without JS no "Show more"
         can run, so every item shows and the button is dropped instead. -->
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-inverse focus:text-on-inverse focus:px-4 focus:py-2">{site.skipToContent}</a>
    <Header lang={lang} />
    <main id="main-content" class="flex-1" data-content-width={contentWidth}>
      <slot />
    </main>
    <Footer lang={lang} alternates={alternates} />
    <CartDrawer client:idle copy={cart} />
    {/*
      client:load, not client:idle like CartDrawer above — CartDrawer is
      dormant until a nav button opens it elsewhere, so a hydration delay is
      invisible. This banner is interactive from first paint; client:idle let
      Accept/Reject sit in the DOM, clickable-looking, before Vue's handlers
      were attached, so an early click did nothing — caught by
      e2e/tests/public/consent-banner.spec.ts.
    */}
    {gaMeasurementId && <ConsentBanner client:load lang={lang} measurementId={gaMeasurementId} copy={bannerCopy} privacyHref={privacyHref} />}
    <ThemeSlot name="page-grain" />
  </body>
</html>
