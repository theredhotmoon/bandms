---
import type { Locale } from '@/types/shared'
import type { Alternates } from '@/lib/locales'
import type { Album, AlbumLink } from '@/types/album'
import BaseLayout from '@/layouts/BaseLayout.astro'
import ThemeSlot from '@/components/ThemeSlot.astro'
import PageHero from '@/components/PageHero.astro'
import AlbumPhotoGrid from '@/components/AlbumPhotoGrid.vue'
import { resolveHeroImages } from '@/lib/heroImages'
import { getSiteConfig } from '@/lib/cms'
import { getSlugMap } from '@/lib/slugs'
import { linkedHref } from '@/lib/albums'
import { fmtDateShort } from '@/lib/i18n'
import { PHOTOS_COPY } from '@bandms/site-copy'
import { moduleCopy, siteCopy } from '@/lib/copy'

interface Props {
  lang: Locale
  alternates: Alternates
  // From the route's getStaticPaths (getAlbums(), memoised): the page never
  // fetches its own record, so a mid-build delete cannot fail the build.
  album: Album
}
const { lang, alternates, album } = Astro.props

const [siteConfig, slugMap] = await Promise.all([getSiteConfig(lang), getSlugMap()])

// The Gallery page's copy: one place in Website Modules → Gallery.
const t = moduleCopy(siteConfig, 'photos', PHOTOS_COPY, lang)
const site = siteCopy(siteConfig, lang)
const galleryHref = `/${lang}/${slugMap[lang]?.photos ?? 'photos'}`

const photos = [...(album.photos ?? [])]
  .sort((a, b) => a.sort_order - b.sort_order)
  // A photo with no file cannot be shown; it would open a broken lightbox.
  .filter(photo => photo.image_url)
  .map(photo => ({
    id: photo.id,
    src: photo.image_url as string,
    caption: photo.caption,
    isPressReady: photo.epk_featured ?? false,
  }))

const when = album.taken_at ? fmtDateShort(album.taken_at, lang) : ''
const kicker = [album.tags?.[0]?.name, when].filter(Boolean).join(' · ')
const shotAt = album.venue?.name ? `${t.shotAt} ${album.venue.name}` : ''

// "See also": the public records linking here, each only if its own page is
// built (a switched-off module unbuilds it). The API already drops drafts.
const KICKER: Record<AlbumLink['type'], string> = {
  post: t.linkedPost, concert: t.linkedConcert, release: t.linkedRelease, shop_item: t.linkedMerch,
}
const linkTitle = (l: AlbumLink): string => {
  if (l.type !== 'concert') return l.title
  if (l.title) return l.title
  return [l.date ? fmtDateShort(l.date, lang) : '', l.venue ?? ''].filter(Boolean).join(' — ')
}
const seeAlso = (album.linked ?? [])
  .map(l => ({ href: linkedHref(l, lang, slugMap, siteConfig.modules), kicker: KICKER[l.type], title: linkTitle(l) }))
  .filter((l): l is { href: string; kicker: string; title: string } => l.href !== null && l.title !== '')
---

<BaseLayout
  module="photos"
  lang={lang}
  alternates={alternates}
  title={album.title}
  description={album.description ?? `${album.title} · ${t.title}`}
  image={photos[0]?.src}
>
  <PageHero
    kicker={kicker || null}
    title={album.title}
    lead={album.description}
    heroImages={resolveHeroImages(siteConfig, 'photos')}
  />

  <ThemeSlot name="section-divider" height={16} tone="accent" />

  <section class="ad-sec page-content" data-testid="album-detail">
    <nav class="ad-crumb" aria-label={site.breadcrumbLabel}>
      <a href={galleryHref} data-testid="album-back">← {t.backToAlbums}</a>
      {shotAt && <span class="ad-shot">{shotAt}</span>}
      <span class="ad-count">{photos.length} {t.photos}</span>
    </nav>

    <AlbumPhotoGrid
      client:visible
      title={album.title}
      photos={photos}
      copy={{
        pressReady: t.pressReady,
        close: t.close,
        prev: t.prev,
        next: t.next,
        openPhoto: t.openPhoto,
      }}
    />
  </section>

  {seeAlso.length > 0 && (
    <section class="ad-also page-content" data-testid="album-see-also">
      <h2 class="ad-also-h">{t.seeAlso}</h2>
      <ul class="ad-also-list">
        {seeAlso.map(l => (
          <li>
            <a class="ad-also-link" href={l.href}>
              <span class="ad-also-kicker">{l.kicker}</span>
              <span class="ad-also-title">{l.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>

<style>
  .ad-sec { padding-block: 32px 56px; }

  .ad-crumb {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 22px;
    margin-bottom: 24px;
    font: 600 14px/1.3 var(--font-body);
    color: var(--color-subtle);
  }
  .ad-crumb a {
    color: var(--color-body);
    font-weight: 800;
    letter-spacing: .06em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .ad-crumb a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .ad-count { font: 700 13px/1 ui-monospace, Menlo, monospace; color: var(--color-accent); }

  .ad-also { padding-block: 0 64px; }
  .ad-also-h {
    margin: 0 0 18px;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 34px;
    line-height: 1;
    letter-spacing: var(--display-tracking);
    text-transform: var(--display-transform);
  }
  .ad-also-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
  }
  .ad-also-link {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    box-sizing: border-box;
    padding: 16px 18px;
    border: var(--border-width-card) solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-body);
    text-decoration: none;
  }
  .ad-also-link:hover .ad-also-title { text-decoration: underline; text-underline-offset: 4px; }
  .ad-also-link:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 2px; }
  .ad-also-kicker {
    font: 800 11px/1 var(--font-body);
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .ad-also-title { font: 700 17px/1.3 var(--font-body); }
</style>
