---
import type { Locale } from '@/types/shared'
import type { Alternates } from '@/lib/locales'
import { getSlugMap } from '@/lib/slugs'
import { postSlug, formatEventDates } from '@/lib/i18n'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getPosts, getPost, getBandProfile, getSiteConfig } from '@/lib/cms'
import PostBlocks from '@/components/blocks/PostBlocks.astro'
import type { PostSummary } from '@/types/post'

const ACCENT = 'var(--color-accent)'

interface Props {
  lang: Locale
  alternates: Alternates
  itemId: number
}

const { lang, alternates, itemId } = Astro.props
const slugMap = await getSlugMap()
const siteConfig = await getSiteConfig(lang)

// Fetch all pages to build summaries for prev/next navigation
const allPosts: PostSummary[] = []
let page = 1
while (true) {
  const { data, meta } = await getPosts(lang, page)
  allPosts.push(...data)
  if (page >= meta.last_page) break
  page++
}
const summaries = allPosts.map(p => ({
  id: p.id,
  slug: postSlug(p, lang),
  title: p.title,
  date: p.published_at ?? p.created_at,
  tags: p.tags,
}))
const idx = summaries.findIndex(s => s.id === itemId)

const [post, profile] = await Promise.all([
  getPost(itemId, lang),
  getBandProfile(lang),
])

const d = new Date((post.published_at ?? post.created_at) + 'T00:00:00')
const mo = ['January','February','March','April','May','June','July','August','September','October','November','December']
const dateStr = `${d.getDate()} ${mo[d.getMonth()]} ${d.getFullYear()}`

// Prev (newer) / next (older) — posts are newest-first
const prevSlug = idx > 0                   ? summaries[idx - 1].slug : null
const nextSlug = idx < summaries.length - 1 ? summaries[idx + 1].slug : null

// More: up to 3 other posts
const more = summaries.filter((_, i) => i !== idx).slice(0, 3)

// This page was hardcoded in English while being served under /pl/ too. Only the
// strings it actually renders are collected here; a full i18n pass over the
// article view is its own change.
const COPY = {
  en: { more: 'More from the blog', event: 'Event' },
  pl: { more: 'Więcej z bloga', event: 'Wydarzenie' },
} as const
const copy = COPY[lang] ?? COPY.en

const eventDateStr = formatEventDates(post.event_dates ?? [], post.event_date_display ?? 'range', lang)

function moShort(iso: string): string {
  const dd = new Date(iso + 'T00:00:00')
  const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec']
  return `${dd.getDate()} ${months[dd.getMonth()]} ${dd.getFullYear()}`
}

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.intro ?? post.excerpt,
  image: post.image ?? undefined,
  datePublished: post.published_at ?? post.created_at,
  author: { '@type': 'Organization', name: profile.name },
  publisher: { '@type': 'Organization', name: profile.name },
  url: Astro.url.href,
}

const postsSection = slugMap[lang].posts ?? 'posts'
---

<BaseLayout
  title={`${post.title} — ${profile.name}`}
  description={post.intro ?? post.excerpt}
  image={post.image}
  structuredData={structuredData}
  lang={lang}
  alternates={alternates}
>
  <Fragment slot="head">
</Fragment>

  <div class="ss">

    <!-- ── DARK HERO HEADER ──────────────────────────────────── -->
    <header class="art-hero">
      <!-- background image -->
      {post.image ? (
        <img src={post.image} alt="" class="art-hero-img" aria-hidden="true" loading="eager" />
      ) : (
        <div class="art-hero-placeholder" aria-hidden="true"></div>
      )}
      <!-- overlays -->
      <div class="art-hero-checker" aria-hidden="true"></div>
      <div class="art-hero-grad" aria-hidden="true"></div>

      <!-- content inside hero -->
      <div class="ar-col art-hero-content">
        <!-- breadcrumb -->
        <nav class="art-crumb" aria-label="Breadcrumb">
          <a class="art-crumb-link" href={`/${lang}`}>Home</a>
          <span class="art-crumb-sep" aria-hidden="true">→</span>
          <a class="art-crumb-link" href={`/${lang}/${postsSection}`}>News</a>
          <span class="art-crumb-sep" aria-hidden="true">→</span>
          <span class="art-crumb-cur">
            {post.tags?.[0]?.name ?? 'Article'}
          </span>
        </nav>

        <!-- tag stamps -->
        {(post.tags ?? []).length > 0 && (
          <div class="art-stamps">
            {(post.tags ?? []).map(tg => (
              <span class="art-stamp">{tg.name}</span>
            ))}
          </div>
        )}

        <!-- title -->
        <h1 class="art-title">{post.title}</h1>

        <!-- intro / standfirst -->
        {post.intro && (
          <p class="art-intro">{post.intro}</p>
        )}

        <!-- meta row -->
        <div class="art-meta">
          <span class="art-meta-date">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke={ACCENT} stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="4.5" width="18" height="16.5" rx="2.2"/><path d="M3 9.5h18M8 2.5v4M16 2.5v4"/>
            </svg>
            {dateStr}
          </span>
          {eventDateStr && (
            <>
              <span class="art-meta-diamond" aria-hidden="true"></span>
              <span class="art-meta-date">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke={ACCENT} stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 2v6M8 4l4 4 4-4M4 22h16M4 22V10h16v12"/>
                </svg>
                {copy.event}: {eventDateStr}
              </span>
            </>
          )}
          <span class="art-meta-diamond" aria-hidden="true"></span>
          <button id="art-share-btn" class="art-share-btn" type="button">
            <svg id="art-share-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke={ACCENT} stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 4h6v6"/><path d="M20 4l-9 9"/>
              <path d="M19 14v5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>
            </svg>
            <span id="art-share-label">Share</span>
          </button>
        </div>
      </div>
    </header>

    <!-- checker strip divider (teal + paper) -->
    <div class="checker-strip-tp" aria-hidden="true"></div>

    <!-- ── ARTICLE BODY ──────────────────────────────────────── -->
    <article class="ar-col art-body">
      <PostBlocks
        blocks={post.blocks ?? []}
        lang={lang}
        slugMap={slugMap}
        modules={siteConfig.modules ?? {}}
      />
    </article>

    <!-- ── BACK ───────────────────────────────────────────────── -->
    <div class="ar-col art-back">
      <a href={`/${lang}/${postsSection}`} class="art-back-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M15 6l-6 6 6 6"/>
        </svg>
        Back to news
      </a>
    </div>

    <!-- ── PREV / NEXT ────────────────────────────────────────── -->
    {(prevSlug || nextSlug) && (
      <section class="ar-col art-prevnext">
        <div class="art-pn-row">
          {prevSlug ? (
            <a class="art-pn-btn art-pn-prev" href={`/${lang}/${postsSection}/${prevSlug}`}>
              <span class="art-pn-dir">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={ACCENT} stroke-width="2" stroke-linecap="round" aria-hidden="true">
                  <path d="M15 6l-6 6 6 6"/>
                </svg>
                Newer post
              </span>
              <span class="art-pn-title">{summaries[idx - 1]?.title}</span>
            </a>
          ) : <div />}
          {nextSlug ? (
            <a class="art-pn-btn art-pn-next" href={`/${lang}/${postsSection}/${nextSlug}`}>
              <span class="art-pn-dir">
                Older post
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={ACCENT} stroke-width="2" stroke-linecap="round" aria-hidden="true">
                  <path d="M9 6l6 6-6 6"/>
                </svg>
              </span>
              <span class="art-pn-title">{summaries[idx + 1]?.title}</span>
            </a>
          ) : <div />}
        </div>
      </section>
    )}

    <!-- ── MORE FROM THE BLOG ─────────────────────────────────── -->
    {more.length > 0 && (
      <section class="art-more-sec">
        <!-- strip: teal + ink (reversed) -->
        <div class="checker-strip-ta" aria-hidden="true"></div>
        <div class="ar-col art-more-inner">
          <h3 class="art-more-title">{copy.more}</h3>
          <div class="art-more-grid">
            {more.map(p => (
              <a href={`/${lang}/${postsSection}/${p.slug}`} class="art-more-card">
                <div class="art-more-img" aria-hidden="true"></div>
                <div class="art-more-body">
                  {p.tags.length > 0 && (
                    <span class="art-more-tag">{p.tags[0].name}</span>
                  )}
                  <h4 class="art-more-card-title">{p.title}</h4>
                  <span class="art-more-date">{moShort(p.date)}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<script>
  const btn   = document.getElementById('art-share-btn') as HTMLButtonElement | null
  const label = document.getElementById('art-share-label') as HTMLSpanElement | null
  const icon  = document.getElementById('art-share-icon') as SVGElement | null

  btn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(window.location.href)
    } catch {
      const ta = document.createElement('textarea')
      ta.value = window.location.href
      document.body.appendChild(ta); ta.select()
      document.execCommand('copy')
      document.body.removeChild(ta)
    }
    if (!btn || !label || !icon) return
    btn.style.background = 'var(--color-accent)'
    btn.style.borderColor = 'var(--color-accent)'
    icon.setAttribute('stroke', 'var(--color-on-accent)')
    label.textContent = 'Copied'
    setTimeout(() => {
      btn.style.background = ''
      btn.style.borderColor = ''
      icon.setAttribute('stroke', 'var(--color-accent)')
      label.textContent = 'Share'
    }, 1800)
  })
</script>

<style>
  /* ── Tokens ─────────────────────────── */
  .ss {
    --paper: var(--color-page);
    --ink:   var(--color-ink);
    --acc:   var(--color-accent);
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-body);
    position: relative;
  }

  /* Grain */

  /* Editorial column (760px, centred, padded) */
  .ar-col {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 32px;
    box-sizing: border-box;
    width: 100%;
  }

  /* ── Checker strips ──────────────────── */
  /* teal + paper */
  .checker-strip-tp {
    height: 14px;
    background-image: repeating-conic-gradient(var(--acc) 0% 25%, var(--paper) 0% 50%);
    background-size: 29px 14px;
  }
  /* teal + ink (reversed, for the "more" section) */
  .checker-strip-ta {
    height: 14px;
    background-image: repeating-conic-gradient(var(--acc) 0% 25%, var(--ink) 0% 50%);
    background-size: 29px 14px;
  }

  /* ── DARK HERO ───────────────────────── */
  .art-hero {
    position: relative;
    background: var(--ink);
    color: var(--paper);
    overflow: hidden;
    min-height: 420px;
  }
  .art-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .art-hero-placeholder {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      45deg,
      var(--color-ink),
      var(--color-ink) 9px,
      var(--color-body) 9px,
      var(--color-body) 18px
    );
  }
  .art-hero-checker {
    position: absolute;
    inset: 0;
    background-image: repeating-conic-gradient(var(--ink) 0% 25%, rgba(255,255,255,.5) 0% 50%);
    background-size: 32px 32px;
    opacity: .10;
  }
  .art-hero-grad {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg,
      color-mix(in oklab, var(--color-ink) 62%, transparent) 0%,
      color-mix(in oklab, var(--color-ink) 74%, transparent) 52%,
      color-mix(in oklab, var(--color-ink) 93%, transparent) 100%
    );
  }
  .art-hero-content {
    position: relative;
    padding-top: 26px;
    padding-bottom: 44px;
  }

  /* Breadcrumb */
  .art-crumb {
    display: flex;
    align-items: center;
    gap: 9px;
    font: 700 12px/1 var(--font-body);
    letter-spacing: .06em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--color-on-inverse) 60%, transparent);
    flex-wrap: wrap;
    margin-bottom: 26px;
  }
  .art-crumb-link {
    color: color-mix(in oklab, var(--color-on-inverse) 60%, transparent);
    text-decoration: none;
    transition: color .12s;
  }
  .art-crumb-link:hover { color: var(--paper); }
  .art-crumb-sep { color: var(--acc); }
  .art-crumb-cur { color: var(--paper); }

  /* Tag stamps (filled) */
  .art-stamps {
    display: flex;
    gap: 9px;
    flex-wrap: wrap;
    margin-bottom: 22px;
  }
  .art-stamp {
    background: var(--acc);
    color: var(--color-on-accent);
    border: 2px solid var(--acc);
    font: 800 11px/1 var(--font-body);
    letter-spacing: .12em;
    text-transform: uppercase;
    padding: 6px 10px;
    white-space: nowrap;
  }

  /* Title */
  .art-title {
    font-family: var(--font-display);
    font-size: clamp(36px, 6vw, 64px);
    line-height: .96;
    letter-spacing: .01em;
    text-transform: uppercase;
    margin: 0 0 22px;
    color: var(--paper);
    text-wrap: balance;
  }

  /* Standfirst / intro */
  .art-intro {
    font: 600 22px/1.5 var(--font-body);
    color: color-mix(in oklab, var(--color-on-inverse) 86%, transparent);
    margin: 0;
    text-wrap: pretty;
  }

  /* Meta row */
  .art-meta {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 24px;
    padding-top: 18px;
    border-top: 2px solid color-mix(in oklab, var(--color-on-inverse) 22%, transparent);
    flex-wrap: wrap;
  }
  .art-meta-date {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: 700 13px/1 var(--font-body);
    letter-spacing: .06em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--color-on-inverse) 72%, transparent);
  }
  .art-meta-diamond {
    width: 5px;
    height: 5px;
    background: var(--acc);
    transform: rotate(45deg);
    flex-shrink: 0;
  }
  .art-share-btn {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    color: var(--paper);
    border: 2px solid var(--paper);
    font: 800 12px/1 var(--font-body);
    letter-spacing: .08em;
    text-transform: uppercase;
    padding: 8px 13px;
    cursor: pointer;
    transition: background .15s, border-color .15s;
  }
  .art-share-btn:hover { background: color-mix(in oklab, var(--color-on-inverse) 12%, transparent); }

  /* ── ARTICLE BODY ────────────────────── */
  /* Content styling (.art-prose, .art-pull, .art-press, .art-rel-link,
     .art-ext-link…) now lives in web/src/components/blocks/ — each block
     component owns its own <style>, since Astro scopes a <style> block to
     elements the file itself renders, not to markup a child component emits. */
  .art-body { padding-top: 44px; padding-bottom: 8px; }

  /* ── BACK ────────────────────────────── */
  .art-back { padding-top: 30px; padding-bottom: 8px; }
  .art-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: transparent;
    border: 3px solid var(--ink);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 15px;
    letter-spacing: .01em;
    text-transform: uppercase;
    padding: 12px 18px;
    text-decoration: none;
    transition: background .12s, color .12s;
  }
  .art-back-btn:hover { background: var(--ink); color: var(--paper); }

  /* ── PREV / NEXT ─────────────────────── */
  .art-prevnext { padding-top: 30px; padding-bottom: 10px; }
  .art-pn-row {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .art-pn-btn {
    display: flex;
    flex-direction: column;
    gap: 8px;
    border: 3px solid var(--ink);
    background: var(--color-surface);
    padding: 18px 20px;
    box-sizing: border-box;
    flex: 1;
    min-width: 200px;
    text-decoration: none;
    color: var(--ink);
    transition: background .12s;
  }
  .art-pn-btn:hover { background: var(--paper); }
  .art-pn-next { align-items: flex-end; text-align: right; }
  .art-pn-dir {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: 800 11px/1 var(--font-body);
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--acc);
  }
  .art-pn-title {
    font-family: var(--font-display);
    font-size: 22px;
    line-height: 1.02;
    letter-spacing: .01em;
    text-transform: uppercase;
  }

  /* ── MORE FROM THE BLOG ──────────────── */
  .art-more-sec {
    margin-top: 36px;
    background: var(--ink);
    color: var(--paper);
  }
  .art-more-inner {
    padding-top: 34px;
    padding-bottom: 60px;
  }
  .art-more-title {
    font-family: var(--font-display);
    font-size: clamp(26px, 3vw, 34px);
    line-height: 1;
    letter-spacing: .01em;
    text-transform: uppercase;
    margin: 0 0 22px;
    color: var(--paper);
  }
  .art-more-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .art-more-card {
    border: 3px solid color-mix(in oklab, var(--color-on-inverse) 25%, transparent);
    background: color-mix(in oklab, var(--color-on-inverse) 6%, transparent);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--paper);
    transition: border-color .14s;
  }
  .art-more-card:hover { border-color: var(--acc); }
  .art-more-img {
    height: 132px;
    border-bottom: 3px solid color-mix(in oklab, var(--color-on-inverse) 25%, transparent);
    background: repeating-linear-gradient(
      45deg,
      var(--color-ink),
      var(--color-ink) 9px,
      var(--color-body) 9px,
      var(--color-body) 18px
    );
    flex-shrink: 0;
  }
  .art-more-body {
    padding: 14px 16px 16px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .art-more-tag {
    font: 800 10px/1 var(--font-body);
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--acc);
    margin-bottom: 9px;
  }
  .art-more-card-title {
    font-family: var(--font-display);
    font-size: 20px;
    line-height: 1.04;
    letter-spacing: .01em;
    text-transform: uppercase;
    margin: 0 0 10px;
    color: var(--paper);
  }
  .art-more-date {
    margin-top: auto;
    font: 700 11px/1 var(--font-body);
    letter-spacing: .06em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--color-on-inverse) 50%, transparent);
  }

  /* ── Responsive ─────────────────────── */
  @media (max-width: 768px) {
    .ar-col { padding: 0 20px; }
    .art-title { font-size: clamp(28px, 8vw, 52px); }
    .art-intro { font-size: 18px; }
    .art-hero { min-height: 340px; }
    .art-more-grid { grid-template-columns: 1fr 1fr; }
    .art-pn-row { flex-direction: column; }
  }
  @media (max-width: 480px) {
    .art-more-grid { grid-template-columns: 1fr; }
  }
</style>
