---
import type { Locale } from '@/types/shared'
import { getSlugMap } from '@/lib/slugs'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getPosts, getPost, getBandProfile } from '@/lib/cms'
import type { PostSummary } from '@/types/post'

const ACCENT = 'var(--color-accent)'

interface Props {
  lang: Locale
  alternateHref: string
  itemId: number
}

const { lang, alternateHref, itemId } = Astro.props
const slugMap = await getSlugMap()

// Fetch all pages to build summaries for prev/next navigation
const allPosts: PostSummary[] = []
let page = 1
while (true) {
  const { data, meta } = await getPosts(lang, page)
  allPosts.push(...data)
  if (page >= meta.last_page) break
  page++
}
const summaries = allPosts.map(p => ({
  id: p.id,
  title: p.title,
  date: p.published_at ?? p.created_at,
  tags: p.tags,
}))
const idx = summaries.findIndex(s => s.id === itemId)

const [post, profile] = await Promise.all([
  getPost(itemId, lang),
  getBandProfile(lang),
])

const d = new Date((post.published_at ?? post.created_at) + 'T00:00:00')
const mo = ['January','February','March','April','May','June','July','August','September','October','November','December']
const dateStr = `${d.getDate()} ${mo[d.getMonth()]} ${d.getFullYear()}`

// Prev (newer) / next (older) — posts are newest-first
const prevId = idx > 0                   ? summaries[idx - 1].id : null
const nextId = idx < summaries.length - 1 ? summaries[idx + 1].id : null

// More: up to 3 other posts
const more = summaries.filter((_, i) => i !== idx).slice(0, 3)

// Coverage of this story. Optional on the resource — it is only present when the
// relation is loaded — so read through ?? rather than bare.
const press = post.press_releases ?? []

// This page was hardcoded in English while being served under /pl/ too. Only the
// strings it actually renders are collected here; a full i18n pass over the
// article view is its own change.
const COPY = {
  en: { related: 'Related', inPress: 'In the press', more: 'More from the blog' },
  pl: { related: 'Powiązane', inPress: 'W mediach', more: 'Więcej z bloga' },
} as const
const copy = COPY[lang] ?? COPY.en

function moShort(iso: string): string {
  const dd = new Date(iso + 'T00:00:00')
  const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec']
  return `${dd.getDate()} ${months[dd.getMonth()]} ${dd.getFullYear()}`
}

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.intro ?? post.excerpt,
  image: post.image ?? undefined,
  datePublished: post.published_at ?? post.created_at,
  author: { '@type': 'Organization', name: profile.name },
  publisher: { '@type': 'Organization', name: profile.name },
  url: Astro.url.href,
}

const postsSection = slugMap[lang].posts ?? 'posts'
const releasesSection = slugMap[lang].releases ?? 'releases'
const concertsSection = slugMap[lang].concerts ?? 'concerts'
---

<BaseLayout
  title={`${post.title} — ${profile.name}`}
  description={post.intro ?? post.excerpt}
  image={post.image}
  structuredData={structuredData}
  lang={lang}
  alternateHref={alternateHref}
>
  <Fragment slot="head">
</Fragment>

  <div class="ss">

    <!-- ── DARK HERO HEADER ──────────────────────────────────── -->
    <header class="art-hero">
      <!-- background image -->
      {post.image ? (
        <img src={post.image} alt="" class="art-hero-img" aria-hidden="true" loading="eager" />
      ) : (
        <div class="art-hero-placeholder" aria-hidden="true"></div>
      )}
      <!-- overlays -->
      <div class="art-hero-checker" aria-hidden="true"></div>
      <div class="art-hero-grad" aria-hidden="true"></div>

      <!-- content inside hero -->
      <div class="ar-col art-hero-content">
        <!-- breadcrumb -->
        <nav class="art-crumb" aria-label="Breadcrumb">
          <a class="art-crumb-link" href={`/${lang}`}>Home</a>
          <span class="art-crumb-sep" aria-hidden="true">→</span>
          <a class="art-crumb-link" href={`/${lang}/${postsSection}`}>News</a>
          <span class="art-crumb-sep" aria-hidden="true">→</span>
          <span class="art-crumb-cur">
            {post.tags?.[0]?.name ?? 'Article'}
          </span>
        </nav>

        <!-- tag stamps -->
        {(post.tags ?? []).length > 0 && (
          <div class="art-stamps">
            {(post.tags ?? []).map(tg => (
              <span class="art-stamp">{tg.name}</span>
            ))}
          </div>
        )}

        <!-- title -->
        <h1 class="art-title">{post.title}</h1>

        <!-- intro / standfirst -->
        {post.intro && (
          <p class="art-intro">{post.intro}</p>
        )}

        <!-- meta row -->
        <div class="art-meta">
          <span class="art-meta-date">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke={ACCENT} stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="4.5" width="18" height="16.5" rx="2.2"/><path d="M3 9.5h18M8 2.5v4M16 2.5v4"/>
            </svg>
            {dateStr}
          </span>
          <span class="art-meta-diamond" aria-hidden="true"></span>
          <button id="art-share-btn" class="art-share-btn" type="button">
            <svg id="art-share-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke={ACCENT} stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 4h6v6"/><path d="M20 4l-9 9"/>
              <path d="M19 14v5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>
            </svg>
            <span id="art-share-label">Share</span>
          </button>
        </div>
      </div>
    </header>

    <!-- checker strip divider (teal + paper) -->
    <div class="checker-strip-tp" aria-hidden="true"></div>

    <!-- ── ARTICLE BODY ──────────────────────────────────────── -->
    <article class="ar-col art-body">
      {post.content && (
        <div class="art-prose" set:html={post.content} />
      )}

      {/* The first piece of coverage doubles as the story's pull quote — the
          design shows press as context inside an article, never as an index. */}
      {press.length > 0 && (
        <blockquote class="art-pull">
          <svg width="34" height="34" viewBox="0 0 24 24" fill={ACCENT} aria-hidden="true">
            <path d="M9 7H5v5h3v-1c0 1.5-.6 2.4-2 3l.6 1.2C9 14.3 10 12.7 10 10V8a1 1 0 0 0-1-1zm9 0h-4v5h3v-1c0 1.5-.6 2.4-2 3l.6 1.2c2.4-1 3.4-2.6 3.4-5.4V8a1 1 0 0 0-1-1z" />
          </svg>
          <p class="art-pull-quote">{press[0].title}</p>
          {press[0].site && <cite class="art-pull-cite">— {press[0].site}</cite>}
        </blockquote>
      )}
    </article>

    <!-- ── RELATED ───────────────────────────────────────────── -->
    {(post.releases.length > 0 || post.concerts.length > 0 || post.music_videos.length > 0) && (
      <section class="ar-col art-related">
        <h3 class="art-related-title">{copy.related}</h3>
        <div class="art-related-links">
          {post.releases.map(r => (
            <a href={`/${lang}/${releasesSection}/${r.id}`} class="art-rel-link">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke={ACCENT} stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3.4"/><circle cx="12" cy="12" r="0.8" fill={ACCENT} stroke="none"/>
              </svg>
              {r.title}
            </a>
          ))}
          {post.music_videos.map(v => (
            <a href={`/${lang}/${releasesSection}`} class="art-rel-link">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke={ACCENT} stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M8 5.5l11 6.5-11 6.5z" fill={ACCENT} stroke="none"/>
              </svg>
              {v.title}
            </a>
          ))}
          {post.concerts.map(c => (
            <a href={`/${lang}/${concertsSection}/${c.slug_en}`} class="art-rel-link">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke={ACCENT} stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 21s7-6.3 7-11a7 7 0 1 0-14 0c0 4.7 7 11 7 11z"/><circle cx="12" cy="10" r="2.6"/>
              </svg>
              {c.venue ? `${c.venue.name}` : c.date}
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- ── IN THE PRESS ──────────────────────────────────────── -->
    {press.length > 0 && (
      <section class="ar-col art-press-sec">
        <h3 class="art-related-title">{copy.inPress}</h3>
        <div class="art-press-list">
          {press.map(item => (
            <a class="art-press" href={item.url} target="_blank" rel="noopener">
              <span>
                {item.site && <span class="art-press-site">{item.site}</span>}
                <span class="art-press-title">{item.title}</span>
              </span>
              <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke={ACCENT} stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M14 4h6v6" /><path d="M20 4l-9 9" />
                <path d="M19 14v5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
              </svg>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- links (from API) -->
    {(post.links ?? []).length > 0 && (
      <section class="ar-col art-links-sec">
        {post.links.map(l => (
          <a href={l.url} target="_blank" rel="noopener noreferrer" class="art-ext-link">
            <span>{l.label ?? l.url}</span>
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke={ACCENT} stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 4h6v6"/><path d="M20 4l-9 9"/>
              <path d="M19 14v5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>
            </svg>
          </a>
        ))}
      </section>
    )}

    <!-- ── BACK ───────────────────────────────────────────────── -->
    <div class="ar-col art-back">
      <a href={`/${lang}/${postsSection}`} class="art-back-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M15 6l-6 6 6 6"/>
        </svg>
        Back to news
      </a>
    </div>

    <!-- ── PREV / NEXT ────────────────────────────────────────── -->
    {(prevId || nextId) && (
      <section class="ar-col art-prevnext">
        <div class="art-pn-row">
          {prevId ? (
            <a class="art-pn-btn art-pn-prev" href={`/${lang}/${postsSection}/${prevId}`}>
              <span class="art-pn-dir">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={ACCENT} stroke-width="2" stroke-linecap="round" aria-hidden="true">
                  <path d="M15 6l-6 6 6 6"/>
                </svg>
                Newer post
              </span>
              <span class="art-pn-title">{summaries[idx - 1]?.title}</span>
            </a>
          ) : <div />}
          {nextId ? (
            <a class="art-pn-btn art-pn-next" href={`/${lang}/${postsSection}/${nextId}`}>
              <span class="art-pn-dir">
                Older post
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={ACCENT} stroke-width="2" stroke-linecap="round" aria-hidden="true">
                  <path d="M9 6l6 6-6 6"/>
                </svg>
              </span>
              <span class="art-pn-title">{summaries[idx + 1]?.title}</span>
            </a>
          ) : <div />}
        </div>
      </section>
    )}

    <!-- ── MORE FROM THE BLOG ─────────────────────────────────── -->
    {more.length > 0 && (
      <section class="art-more-sec">
        <!-- strip: teal + ink (reversed) -->
        <div class="checker-strip-ta" aria-hidden="true"></div>
        <div class="ar-col art-more-inner">
          <h3 class="art-more-title">{copy.more}</h3>
          <div class="art-more-grid">
            {more.map(p => (
              <a href={`/${lang}/${postsSection}/${p.id}`} class="art-more-card">
                <div class="art-more-img" aria-hidden="true"></div>
                <div class="art-more-body">
                  {p.tags.length > 0 && (
                    <span class="art-more-tag">{p.tags[0].name}</span>
                  )}
                  <h4 class="art-more-card-title">{p.title}</h4>
                  <span class="art-more-date">{moShort(p.date)}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<script>
  const btn   = document.getElementById('art-share-btn') as HTMLButtonElement | null
  const label = document.getElementById('art-share-label') as HTMLSpanElement | null
  const icon  = document.getElementById('art-share-icon') as SVGElement | null

  btn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(window.location.href)
    } catch {
      const ta = document.createElement('textarea')
      ta.value = window.location.href
      document.body.appendChild(ta); ta.select()
      document.execCommand('copy')
      document.body.removeChild(ta)
    }
    if (!btn || !label || !icon) return
    btn.style.background = 'var(--color-accent)'
    btn.style.borderColor = 'var(--color-accent)'
    icon.setAttribute('stroke', 'var(--color-on-accent)')
    label.textContent = 'Copied'
    setTimeout(() => {
      btn.style.background = ''
      btn.style.borderColor = ''
      icon.setAttribute('stroke', 'var(--color-accent)')
      label.textContent = 'Share'
    }, 1800)
  })
</script>

<style>
  /* ── Tokens ─────────────────────────── */
  .ss {
    --paper: var(--color-page);
    --ink:   var(--color-ink);
    --acc:   var(--color-accent);
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-body);
    position: relative;
  }

  /* Grain */

  /* Editorial column (760px, centred, padded) */
  .ar-col {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 32px;
    box-sizing: border-box;
    width: 100%;
  }

  /* ── Checker strips ──────────────────── */
  /* teal + paper */
  .checker-strip-tp {
    height: 14px;
    background-image: repeating-conic-gradient(var(--acc) 0% 25%, var(--paper) 0% 50%);
    background-size: 29px 14px;
  }
  /* teal + ink (reversed, for the "more" section) */
  .checker-strip-ta {
    height: 14px;
    background-image: repeating-conic-gradient(var(--acc) 0% 25%, var(--ink) 0% 50%);
    background-size: 29px 14px;
  }

  /* ── DARK HERO ───────────────────────── */
  .art-hero {
    position: relative;
    background: var(--ink);
    color: var(--paper);
    overflow: hidden;
    min-height: 420px;
  }
  .art-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .art-hero-placeholder {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      45deg,
      var(--color-ink),
      var(--color-ink) 9px,
      var(--color-body) 9px,
      var(--color-body) 18px
    );
  }
  .art-hero-checker {
    position: absolute;
    inset: 0;
    background-image: repeating-conic-gradient(var(--ink) 0% 25%, rgba(255,255,255,.5) 0% 50%);
    background-size: 32px 32px;
    opacity: .10;
  }
  .art-hero-grad {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg,
      color-mix(in oklab, var(--color-ink) 62%, transparent) 0%,
      color-mix(in oklab, var(--color-ink) 74%, transparent) 52%,
      color-mix(in oklab, var(--color-ink) 93%, transparent) 100%
    );
  }
  .art-hero-content {
    position: relative;
    padding-top: 26px;
    padding-bottom: 44px;
  }

  /* Breadcrumb */
  .art-crumb {
    display: flex;
    align-items: center;
    gap: 9px;
    font: 700 12px/1 var(--font-body);
    letter-spacing: .06em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--color-on-inverse) 60%, transparent);
    flex-wrap: wrap;
    margin-bottom: 26px;
  }
  .art-crumb-link {
    color: color-mix(in oklab, var(--color-on-inverse) 60%, transparent);
    text-decoration: none;
    transition: color .12s;
  }
  .art-crumb-link:hover { color: var(--paper); }
  .art-crumb-sep { color: var(--acc); }
  .art-crumb-cur { color: var(--paper); }

  /* Tag stamps (filled) */
  .art-stamps {
    display: flex;
    gap: 9px;
    flex-wrap: wrap;
    margin-bottom: 22px;
  }
  .art-stamp {
    background: var(--acc);
    color: var(--color-on-accent);
    border: 2px solid var(--acc);
    font: 800 11px/1 var(--font-body);
    letter-spacing: .12em;
    text-transform: uppercase;
    padding: 6px 10px;
    white-space: nowrap;
  }

  /* Title */
  .art-title {
    font-family: var(--font-display);
    font-size: clamp(36px, 6vw, 64px);
    line-height: .96;
    letter-spacing: .01em;
    text-transform: uppercase;
    margin: 0 0 22px;
    color: var(--paper);
    text-wrap: balance;
  }

  /* Standfirst / intro */
  .art-intro {
    font: 600 22px/1.5 var(--font-body);
    color: color-mix(in oklab, var(--color-on-inverse) 86%, transparent);
    margin: 0;
    text-wrap: pretty;
  }

  /* Meta row */
  .art-meta {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 24px;
    padding-top: 18px;
    border-top: 2px solid color-mix(in oklab, var(--color-on-inverse) 22%, transparent);
    flex-wrap: wrap;
  }
  .art-meta-date {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: 700 13px/1 var(--font-body);
    letter-spacing: .06em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--color-on-inverse) 72%, transparent);
  }
  .art-meta-diamond {
    width: 5px;
    height: 5px;
    background: var(--acc);
    transform: rotate(45deg);
    flex-shrink: 0;
  }
  .art-share-btn {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    color: var(--paper);
    border: 2px solid var(--paper);
    font: 800 12px/1 var(--font-body);
    letter-spacing: .08em;
    text-transform: uppercase;
    padding: 8px 13px;
    cursor: pointer;
    transition: background .15s, border-color .15s;
  }
  .art-share-btn:hover { background: color-mix(in oklab, var(--color-on-inverse) 12%, transparent); }

  /* ── ARTICLE BODY ────────────────────── */
  .art-body { padding-top: 44px; padding-bottom: 8px; }
  /* Pull quote — the first press headline, set as display type. */
  .art-pull {
    margin: 12px 0 30px;
    border-left: 6px solid var(--color-accent);
    padding-left: 26px;
  }
  .art-pull-quote {
    margin: 8px 0 12px;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 30px;
    line-height: 1.12;
    letter-spacing: var(--display-tracking);
    text-transform: var(--display-transform);
    color: var(--color-body);
  }
  .art-pull-cite {
    font: 800 12px/1 var(--font-body);
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-style: normal;
  }

  /* In the press — ink rows, one per outlet. */
  .art-press-sec { padding-top: 26px; }
  .art-press-list { display: flex; flex-direction: column; gap: 10px; }
  .art-press {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    background: var(--color-inverse);
    color: var(--color-on-inverse);
    padding: 16px 20px;
    text-decoration: none;
  }
  .art-press-site {
    display: block;
    font: 800 10px/1 var(--font-body);
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .art-press-title {
    display: block;
    margin-top: 7px;
    font: 600 16px/1.4 var(--font-body);
  }

  @media (max-width: 700px) {
    .art-pull-quote { font-size: 22px; }
    .art-pull { padding-left: 16px; }
  }

  .art-prose {
    font: 500 18.5px/1.72 var(--font-body);
    color: var(--color-body);
  }
  /* Drop cap on first paragraph's first letter */
  .art-prose > p:first-of-type::first-letter {
    float: left;
    font-family: var(--font-display);
    font-size: 96px;
    line-height: .74;
    color: var(--acc);
    margin-right: 14px;
    margin-top: 6px;
  }
  .art-prose > p { margin: 0 0 24px; text-wrap: pretty; }
  .art-prose > p:last-child { margin-bottom: 0; }
  .art-prose > h2,
  .art-prose > h3 {
    font-family: var(--font-display);
    text-transform: uppercase;
    margin: 32px 0 12px;
    color: var(--ink);
  }
  .art-prose a { color: var(--acc); text-underline-offset: 3px; }
  .art-prose blockquote {
    margin: 12px 0 30px;
    border-left: 6px solid var(--acc);
    padding-left: 26px;
  }

  /* ── RELATED ─────────────────────────── */
  .art-related { padding-top: 14px; padding-bottom: 8px; }
  .art-related-title {
    font-family: var(--font-display);
    font-size: 22px;
    line-height: 1.05;
    letter-spacing: .01em;
    text-transform: uppercase;
    margin: 0 0 16px;
    color: var(--ink);
  }
  .art-related-links {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .art-rel-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 3px solid var(--ink);
    padding: 11px 15px;
    font: 700 14px/1 var(--font-body);
    text-transform: uppercase;
    letter-spacing: .04em;
    color: var(--ink);
    text-decoration: none;
