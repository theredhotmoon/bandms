---
import type { Locale } from '@/types/shared'
import type { Alternates } from '@/lib/locales'
import BaseLayout from '@/layouts/BaseLayout.astro'
import ThemeSlot from '@/components/ThemeSlot.astro'
import Icon from '@/components/Icon.astro'
import MemberPhotoGrid from '@/components/MemberPhotoGrid.vue'
import { getMembers, getBandProfile, getSiteConfig, getAllPosts, getConcerts, getClips, getReleases, getMusicVideos } from '@/lib/cms'
import ClipsGrid from '@/components/ClipsGrid.astro'
import { fmtDate, postSlug } from '@/lib/i18n'
import { getSlugMap } from '@/lib/slugs'
import { ABOUT_COPY, fillCopy } from '@bandms/site-copy'
import { gearTypeLabels } from '@bandms/rider-core'
import { moduleCopy, siteCopy } from '@/lib/copy'

/**
 * A band member's own page — their "postcard". Shareable on its own and
 * printed as a QR code from the admin, which is why its URL is the member's
 * slug and never moves when they are renamed.
 */
interface Props {
  lang: Locale
  alternates: Alternates
  itemId: number
}

const { lang, alternates, itemId } = Astro.props

const [members, profile, siteConfig, slugMap, allPosts, allConcerts, allClips, allReleases, allVideos] = await Promise.all([
  getMembers(lang),
  getBandProfile(lang),
  getSiteConfig(lang),
  getSlugMap(),
  getAllPosts(lang),
  getConcerts(),
  getClips(lang),
  getReleases(lang),
  getMusicVideos(),
])

const member = members.find((m) => m.id === itemId)!
const t = moduleCopy(siteConfig, 'about', ABOUT_COPY, lang)
const site = siteCopy(siteConfig, lang)
const aboutHref = `/${lang}/${slugMap[lang]?.about ?? 'about'}`

const name = [member.first_name, member.nickname ? `“${member.nickname}”` : null, member.last_name]
  .filter(Boolean)
  .join(' ')
const year = (date: string | null) => (date ? date.slice(0, 4) : null)
const tenure = member.is_current
  ? (year(member.joined_at) ? fillCopy(t.memberSince, { year: year(member.joined_at)! }) : null)
  : (year(member.joined_at) && year(member.quit_at)
      ? fillCopy(t.memberWas, { from: year(member.joined_at)!, to: year(member.quit_at)! })
      : t.former)

// Main instrument first, then the rest without repeating it.
const instruments = [
  ...(member.main_instrument ? [member.main_instrument.name] : []),
  ...(member.instruments ?? []).map((i) => i.name).filter((n) => n !== member.main_instrument?.name),
]

// News linked to the member, in the order the API gives (newest first). The
// titles, dates and per-language URLs come from the post list the site
// already builds from, so they match the News section exactly. Gated on the
// posts module: a switched-off module unbuilds the pages these would link to.
const postsHref = `/${lang}/${slugMap[lang]?.posts ?? 'posts'}`
const postsById = new Map(allPosts.map((p) => [p.id, p]))
const news = siteConfig.modules.posts === false ? [] : (member.post_ids ?? [])
  .map((id) => postsById.get(id))
  .filter((p): p is NonNullable<typeof p> => Boolean(p))
  .map((p) => ({ id: p.id, title: p.title, date: fmtDate(p.published_at, lang), href: `${postsHref}/${postSlug(p, lang)}` }))

// Concerts the member played, newest first, each leading to its show page.
// Gated on the concerts module, like the news above.
const concertsHref = `/${lang}/${slugMap[lang]?.concerts ?? 'concerts'}`
const concertsById = new Map(allConcerts.map((c) => [c.id, c]))
const gigs = siteConfig.modules.concerts === false ? [] : (member.concert_ids ?? [])
  .map((id) => concertsById.get(id))
  .filter((c): c is NonNullable<typeof c> => Boolean(c))
  .map((c) => ({
    id: c.id,
    date: fmtDate(c.date, lang),
    place: [c.venue?.name, c.venue?.city].filter(Boolean).join(', '),
    href: `${concertsHref}/${c.slug}`,
  }))

// Clips the member appears in, in the API's order (most recent first). Clips
// have no module of their own — they render on concerts, releases and merch
// whatever is switched on — so this block is not gated.
const clipsById = new Map(allClips.map((c) => [c.id, c]))
const memberClips = (member.clip_ids ?? [])
  .map((id) => clipsById.get(id))
  .filter((c): c is NonNullable<typeof c> => Boolean(c))

// Releases the member played on, newest first, each leading to its page.
// Gated on the releases module: a switched-off module unbuilds those pages.
const releasesHref = `/${lang}/${slugMap[lang]?.releases ?? 'releases'}`
const releasesById = new Map(allReleases.map((r) => [r.id, r]))
const discography = siteConfig.modules.releases === false ? [] : (member.release_ids ?? [])
  .map((id) => releasesById.get(id))
  .filter((r): r is NonNullable<typeof r> => Boolean(r))
  .map((r) => ({
    id: r.id,
    title: r.title,
    year: r.release_date ? r.release_date.slice(0, 4) : '',
    cover: r.cover_image,
    href: `${releasesHref}/${r.id}`,
  }))

// Music videos the member appears in, newest first. The API sends published
// ones only; each opens the video itself. Gated on the videos module.
const videosById = new Map(allVideos.map((v) => [v.id, v]))
const videos = siteConfig.modules.videos === false ? [] : (member.music_video_ids ?? [])
  .map((id) => videosById.get(id))
  .filter((v): v is NonNullable<typeof v> => Boolean(v))
  .map((v) => ({ id: v.id, title: v.title, thumb: v.og_image, href: v.video_url }))

// The member's own kit, in the visitor's language. Two kinds of item are left
// out: `own_gear: false` is "backline needed" in the admin — something the
// venue supplies, not part of their rig — and an item with neither a label
// nor a model says nothing worth printing. Fields are read defensively: one
// non-string here would fail the whole static build.
const text = (v: unknown) => (typeof v === 'string' ? v.trim() : '')
const gearTypes = gearTypeLabels(lang)
const gear = (member.default_gear ?? [])
  .filter((g) => g.own_gear !== false)
  .map((g) => ({ id: g.id, type: gearTypes[g.type] ?? gearTypes.other, label: text(g.label), model: text(g.brand_model) }))
  .filter((g) => g.label || g.model)

const ICONS = new Set(['instagram', 'facebook', 'youtube', 'spotify', 'bandcamp', 'soundcloud'])
const socials = (member.social_links ?? []).map((s) => ({ ...s, icon: ICONS.has(s.platform) ? s.platform : 'external' }))

// `||`, not `??`: a bio saved as '' would otherwise give an empty description.
const description = member.bio?.slice(0, 160) || [member.role, profile.name].filter(Boolean).join(' · ')
// Structured data needs an absolute URL; the API strips the host from photos.
const origin = (Astro.site?.toString() ?? Astro.url.origin).replace(/\/$/, '')
const photoUrl = member.photo ? (member.photo.startsWith('http') ? member.photo : `${origin}${member.photo}`) : null

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name,
  ...(member.role ? { jobTitle: member.role } : {}),
  ...(photoUrl ? { image: photoUrl } : {}),
  memberOf: { '@type': 'MusicGroup', name: profile.name },
  ...(socials.length ? { sameAs: socials.map((s) => s.url) } : {}),
}
---

<BaseLayout
  lang={lang}
  alternates={alternates}
  title={name}
  description={description}
  image={member.photo}
  structuredData={structuredData}
>
  <section class="md-hero page-x">
    <ThemeSlot name="hero-backdrop" />
    <div class="md-hero-in">
      <nav class="md-crumb" aria-label={site.breadcrumbLabel}>
        <a href={aboutHref}>{t.memberBack}</a>
        <span class="md-crumb-sep" aria-hidden="true">→</span>
        <span class="md-crumb-cur">{name}</span>
      </nav>

      {member.role && <span class="md-kicker">{member.role}</span>}
      <h1 class="md-h1" data-testid="member-name">{name}</h1>
      <p class="md-band">{profile.name}</p>
      {tenure && <p class="md-tenure" data-testid="member-tenure">{tenure}</p>}

      <div class="md-actions">
        <button
          type="button"
          class="md-share"
          data-member-share
          data-copied={t.memberCopied}
          data-testid="member-share"
        >
          <Icon name="external" size={16} color="currentColor" />
          <span data-share-label>{t.memberShare}</span>
        </button>
      </div>
    </div>
  </section>

  <ThemeSlot name="section-divider" height={16} tone="accent" />

  <section class="md-sec page-x">
    <div class="md-grid">
      <div class="md-photo">
        {member.photo
          ? <img src={member.photo} alt={name} loading="eager" />
          : <span class="md-photo-fallback" aria-hidden="true" />}
      </div>

      <div class="md-body">
        {member.bio && <p class="md-bio" data-testid="member-bio">{member.bio}</p>}

        {instruments.length > 0 && (
          <div class="md-plays" data-testid="member-instruments">
            <span class="md-label">{t.plays}</span>
            <div class="md-chips">
              {instruments.map((i) => <span class="md-chip">{i}</span>)}
            </div>
          </div>
        )}

        {socials.length > 0 && (
          <div class="md-follow">
            <span class="md-label">{t.memberFollow}</span>
            <div class="md-socials">
              {socials.map((s) => (
                <a class="md-social" href={s.url} target="_blank" rel="noopener" aria-label={s.platform}>
                  <Icon name={s.icon} size={20} color="currentColor" />
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  {(member.photos?.length ?? 0) > 0 && (
    <section class="md-sec page-x" data-testid="member-photos">
      <h2 class="md-h2">{t.memberPhotos}</h2>
      <MemberPhotoGrid
        client:visible
        photos={member.photos!}
        alt={name}
        copy={{ title: name, close: t.close, prev: t.memberPhotoPrev, next: t.memberPhotoNext }}
      />
    </section>
  )}

  {news.length > 0 && (
    <section class="md-sec page-x" data-testid="member-news">
      <h2 class="md-h2">{t.memberNews}</h2>
      <ul class="md-news">
        {news.map((n) => (
          <li>
            <a class="md-news-row" href={n.href} data-testid="member-news-item">
              <span class="md-news-title">{n.title}</span>
              {n.date && <span class="md-news-date">{n.date}</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {gigs.length > 0 && (
    <section class="md-sec page-x" data-testid="member-gigs">
      <h2 class="md-h2">{t.memberGigs}</h2>
      <ul class="md-news">
        {gigs.map((g) => (
          <li>
            <a class="md-news-row" href={g.href} data-testid="member-gig">
              <span class="md-news-title">{g.place}</span>
              <span class="md-news-date">{g.date}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {memberClips.length > 0 && (
    <section class="md-sec page-x" data-testid="member-clips">
      <ClipsGrid clips={memberClips} heading={t.memberClips} copy={site} />
    </section>
  )}

  {discography.length > 0 && (
    <section class="md-sec page-x" data-testid="member-releases">
      <h2 class="md-h2">{t.memberReleases}</h2>
      <ul class="md-releases">
        {discography.map((r) => (
          <li>
            <a class="md-release" href={r.href} data-testid="member-release">
              <span class="md-release-cover">
                {r.cover ? <img src={r.cover} alt="" loading="lazy" /> : <span class="md-photo-fallback" aria-hidden="true" />}
              </span>
              <span class="md-release-title">{r.title}</span>
              {r.year && <span class="md-release-year">{r.year}</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {videos.length > 0 && (
    <section class="md-sec page-x" data-testid="member-videos">
      <h2 class="md-h2">{t.memberVideos}</h2>
      <ul class="md-releases">
        {videos.map((v) => (
          <li>
            <a class="md-release" href={v.href} target="_blank" rel="noopener" data-testid="member-video">
              <span class="md-release-cover md-video-thumb">
                {v.thumb ? <img src={v.thumb} alt="" loading="lazy" /> : <span class="md-photo-fallback" aria-hidden="true" />}
              </span>
              <span class="md-release-title">{v.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- Gear: the member's own kit, or a "coming soon" line until they add some. -->
  <section class="md-sec page-x" data-testid="member-gear">
    <h2 class="md-h2">{t.memberGear}</h2>
    {gear.length > 0 ? (
      <ul class="md-gear">
        {gear.map((g) => (
          <li class="md-gear-card" data-testid="member-gear-item">
            <span class="md-gear-type">{g.type}</span>
            {g.label && <span class="md-gear-label">{g.label}</span>}
            {g.model && <span class="md-gear-model">{g.model}</span>}
          </li>
        ))}
      </ul>
    ) : (
      <p class="md-gear-soon">{t.memberGearSoon}</p>
    )}
  </section>
</BaseLayout>

<script>
  // Share the page: the native sheet where there is one, the clipboard
  // otherwise. Labels come in through data attributes — a script has no copy.
  document.querySelectorAll<HTMLButtonElement>('[data-member-share]').forEach((button) => {
    button.addEventListener('click', async () => {
      const url = window.location.href
      if (navigator.share) {
        try {
          await navigator.share({ title: document.title, url })
          return
        } catch (e) {
          // Closing the share sheet is a choice, not a failure: leave the
          // clipboard alone. Only a sheet that could not open falls back.
          if (e instanceof DOMException && e.name === 'AbortError') return
        }
      }
      try {
        await navigator.clipboard.writeText(url)
        const label = button.querySelector('[data-share-label]')
        if (label) {
          const original = label.textContent
          label.textContent = button.dataset.copied ?? ''
          setTimeout(() => { label.textContent = original }, 2000)
        }
      } catch { /* clipboard blocked: nothing useful to do */ }
    })
  })
</script>

<style>
  /* The hero is an inverse band, like every detail page's (ReleaseDetail). */
  .md-hero { position: relative; overflow: hidden; background: var(--color-inverse); color: var(--color-on-inverse); padding-block: 26px 50px; }
  .md-hero-in { position: relative; }
  .md-crumb { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; margin-bottom: 26px; font: 700 12px/1 var(--font-body); letter-spacing: .1em; text-transform: uppercase; color: color-mix(in oklab, var(--color-on-inverse) 62%, transparent); }
  .md-crumb a { color: inherit; }
  .md-crumb a:hover { color: var(--color-on-inverse); }
  .md-crumb-sep { color: var(--color-accent); }
  .md-crumb-cur { color: var(--color-on-inverse); }
  .md-kicker { display: block; font: 800 13px/1 var(--font-body); letter-spacing: .18em; text-transform: uppercase; color: var(--color-accent); }
  .md-h1 { margin: 14px 0 0; font-size: 84px; line-height: .86; text-wrap: balance; }
  .md-band { margin: 14px 0 0; font: 700 18px/1.2 var(--font-body); color: color-mix(in oklab, var(--color-on-inverse) 82%, transparent); }
  .md-tenure { margin: 8px 0 0; font: 700 13px/1 var(--font-body); letter-spacing: .06em; text-transform: uppercase; color: color-mix(in oklab, var(--color-on-inverse) 62%, transparent); }
  .md-actions { margin-top: 28px; display: flex; gap: 12px; }
  .md-share {
    display: inline-flex; align-items: center; gap: 8px; padding: 12px 20px;
    border: 2px solid currentColor; border-radius: var(--radius-card);
    background: transparent; color: var(--color-on-inverse);
    font: 800 13px/1 var(--font-body); letter-spacing: .08em; text-transform: uppercase; cursor: pointer;
  }
  .md-share:hover { border-color: var(--color-accent); color: var(--color-accent); }

  .md-sec { padding-top: 56px; padding-bottom: 56px; }
  .md-grid { display: grid; grid-template-columns: minmax(0, 360px) minmax(0, 1fr); gap: 48px; align-items: start; }
  @media (max-width: 760px) { .md-grid { grid-template-columns: 1fr; gap: 28px; } }
  .md-photo { aspect-ratio: 4 / 5; border-radius: var(--radius-card); overflow: hidden; background: var(--color-surface); box-shadow: var(--shadow-card); }
  .md-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .md-photo-fallback { display: block; width: 100%; height: 100%; background: var(--color-surface-2); }
  .md-body { display: flex; flex-direction: column; gap: 28px; }
  .md-bio { margin: 0; font: 500 19px/1.6 var(--font-body); color: var(--color-body); white-space: pre-line; text-wrap: pretty; }
  .md-label { display: block; margin-bottom: 10px; font: 800 11px/1 var(--font-body); letter-spacing: .12em; text-transform: uppercase; color: var(--color-subtle); }
  .md-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .md-chip { padding: 7px 12px; border: 1px solid var(--color-border); border-radius: var(--radius-pill); font: 700 13px/1 var(--font-body); color: var(--color-body); }
  .md-socials { display: flex; gap: 10px; }
  .md-social { display: inline-flex; padding: 10px; border: 1px solid var(--color-border); border-radius: var(--radius-card); color: var(--color-body); }
  .md-social:hover { color: var(--color-accent); border-color: var(--color-accent); }

  .md-h2 { margin: 0 0 24px; font-size: 44px; line-height: 1; }
  .md-gear { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 16px; }
  .md-gear-card { display: flex; flex-direction: column; gap: 6px; padding: 18px 20px; border: 1px solid var(--color-border); border-radius: var(--radius-card); background: var(--color-surface); }
  @media (max-width: 760px) {
    .md-hero { padding-block: 20px 34px; }
    .md-h1 { font-size: 38px; }
    .md-sec { padding-block: 32px; }
  }
  .md-gear-type { font: 800 11px/1 var(--font-body); letter-spacing: .12em; text-transform: uppercase; color: var(--color-subtle); }
  .md-gear-label { font: 700 17px/1.3 var(--font-body); color: var(--color-body); }
  .md-gear-model { font: 500 14px/1.4 var(--font-body); color: var(--color-muted); }
  .md-news { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .md-news-row { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--color-border); color: var(--color-body); text-decoration: none; }
  .md-news-row:hover .md-news-title { color: var(--color-accent); }
  .md-news-title { font: 700 18px/1.35 var(--font-body); }
  .md-news-date { flex-shrink: 0; font: 600 13px/1 var(--font-body); color: var(--color-muted); }
  .md-releases { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 20px; }
  .md-release { display: flex; flex-direction: column; gap: 6px; color: var(--color-body); text-decoration: none; }
  .md-release-cover { display: block; aspect-ratio: 1; border-radius: var(--radius-card); overflow: hidden; background: var(--color-surface-2); box-shadow: var(--shadow-card); }
  .md-release-cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .md-release:hover .md-release-title { color: var(--color-accent); }
  .md-video-thumb { aspect-ratio: 16 / 9; }
  .md-release-title { font: 700 16px/1.3 var(--font-body); }
  .md-release-year { font: 600 13px/1 var(--font-body); color: var(--color-muted); }
  .md-gear-soon { margin: 4px 0 0; font: 500 15px/1.5 var(--font-body); color: var(--color-muted); }
</style>
