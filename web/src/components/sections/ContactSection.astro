---
import { dateLocale } from '@/lib/locales'
import type { Alternates } from '@/lib/locales'
import type { Locale } from '@/types/shared'
import BaseLayout from '@/layouts/BaseLayout.astro'
import ContactForm from '@/components/ContactForm.vue'
import AvailabilityModal from '@/components/AvailabilityModal.vue'
import EpkModal from '@/components/EpkModal.vue'
import SocialLinks from '@/components/SocialLinks.astro'
import FaqSection from '@/components/sections/FaqSection.astro'
import ThemeSlot from '@/components/ThemeSlot.astro'
import Icon from '@/components/Icon.astro'
import { getBandProfile, getSocialLinks, getSiteConfig, getEpkOptional } from '@/lib/cms'
import { getSlugMap } from '@/lib/slugs'

interface Props {
  lang?: Locale
  alternates?: Alternates
}
const { lang = 'en', alternates } = Astro.props

const [profile, socialLinks, siteConfig, slugMap, epk] = await Promise.all([
  getBandProfile(lang),
  getSocialLinks(),
  getSiteConfig(lang),
  getSlugMap(),
  // Fails open: the press kit is supplementary to this page, and a throw here
  // would take down all 35 pages rather than one modal.
  getEpkOptional(lang),
])

// Band-editable copy. `settings` is optional because an API predating the
// migration omits it, so every read goes through ?? — a bare access would throw
// at build time and the Astro build is all-or-nothing.
const s = siteConfig.module_config?.contact?.settings ?? {}

const COPY = {
  en: {
    title: 'Contact',
    formTitle: 'Send a message', formSub: 'Fill in the form and hit send — it lands straight in our inbox.',
    reasonLabel: "What's this about?",
    reasons: [
      { value: 'general' as const, label: 'Say hello' },
      { value: 'booking' as const, label: 'Booking' },
      { value: 'press' as const, label: 'Press' },
      { value: 'other' as const, label: 'Other' },
    ],
    name: 'Your name', namePh: 'Jane Skankowska',
    email: 'Email', emailPh: 'you@email.com',
    subject: 'Subject', subjectPh: "What's on your mind?",
    message: 'Message', messagePh: 'Tell us everything — dates, venue, capacity, the lot.',
    send: 'Send message', sending: 'Sending…',
    sent: "Message sent — we'll be in touch within 48h. BIG UP!",
    sendAnother: 'Send another',
    error: 'Please add your name, a valid email and a message.',
    directTitle: 'Reach us directly',
    booking: 'Booking', press: 'Press', general: 'General',
    follow: 'Or find us on',
    promoTitle: 'Promoters & press',
    promoSub: 'Everything you need to put us on your stage — or your page.',
    bookTitle: 'Book us', bookSub: 'Check open dates and send a request.', bookCta: 'Check availability',
    epkTitle: 'Press kit (EPK)', epkSub: 'Bio, hi-res photos, logos & stats in one pack.', epkCta: 'Open EPK',
    riderTitle: 'Tech rider', riderSub: 'Stage plan, input list, monitors & hospitality.', riderCta: 'View rider',
    photosTitle: 'Press photos', photosSub: 'Hi-res, print-ready shots in the gallery.', photosCta: 'Open gallery',
    bookingSubject: 'Booking request — {date}',
    bookingSubjectUnavailable: 'Booking request — {date} (we had this date marked busy)',
    epk: {
      title: 'Press kit (EPK)',
      subtitle: 'Everything press and promoters need, in one place.',
      contents: "What's inside",
      allLabel: 'Open the full press kit',
      close: 'Close',
      empty: "The press kit is still being put together — email us and we'll send what you need.",
      bio: 'Band bio', bioMeta: 'Short, medium and long',
      photos: 'Press photos', photosMeta: '{n} hi-res shots',
      logo: 'Logo', logoMeta: 'Full-colour, web and print',
      streaming: 'Streaming & stats', streamingMeta: '{n} platforms',
      monthlyMeta: '{n} monthly listeners',
      rider: 'Tech rider', riderMeta: 'Stage plan & input list · PDF',
      stagePlot: 'Stage plot', stagePlotMeta: 'Backline & positions · PDF',
    },
    cal: {
      title: 'Check our availability',
      subtitle: "Pick a date and send a request — we'll reply within 48h.",
      open: 'Open', booked: 'Booked', held: 'On hold',
      request: 'Request this date',
      pickPrompt: 'Select a date',
      close: 'Close',
      loadError: "We couldn't load the calendar just now — tell us your date in the contact form and we'll confirm by email.",
      loading: 'Checking which dates are free…',
      confirmTitle: 'That date looks taken',
      confirmBody: "We already have something on {date}. You're welcome to ask anyway — we'll reply either way, and plans do change.",
      confirmYes: 'Ask anyway',
      confirmNo: 'Choose another',
      months: ['January', 'February', 'March', 'April', 'May', 'June',
               'July', 'August', 'September', 'October', 'November', 'December'],
      weekdays: ['Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa', 'Su'],
    },
  },
  pl: {
    title: 'Kontakt',
    formTitle: 'Napisz do nas', formSub: 'Wypełnij formularz i wyślij — trafi prosto na naszą skrzynkę.',
    reasonLabel: 'W jakiej sprawie?',
    reasons: [
      { value: 'general' as const, label: 'Przywitaj się' },
      { value: 'booking' as const, label: 'Booking' },
      { value: 'press' as const, label: 'Prasa' },
      { value: 'other' as const, label: 'Inne' },
    ],
    name: 'Imię i nazwisko', namePh: 'Jan Skankowski',
    email: 'Email', emailPh: 'ty@email.com',
    subject: 'Temat', subjectPh: 'O czym chcesz napisać?',
    message: 'Wiadomość', messagePh: 'Napisz wszystko — daty, miejsce, pojemność sali, całość.',
    send: 'Wyślij wiadomość', sending: 'Wysyłanie…',
    sent: 'Wiadomość wysłana — odezwiemy się w 48h. BIG UP!',
    sendAnother: 'Wyślij kolejną',
    error: 'Podaj imię, poprawny email i treść wiadomości.',
    directTitle: 'Napisz bezpośrednio',
    booking: 'Booking', press: 'Prasa', general: 'Ogólny',
    follow: 'Albo znajdź nas na',
    promoTitle: 'Organizatorzy i prasa',
    promoSub: 'Wszystko, czego potrzebujesz, by zaprosić nas na scenę — lub na łamy.',
    bookTitle: 'Zarezerwuj nas', bookSub: 'Sprawdź wolne terminy i wyślij zapytanie.', bookCta: 'Sprawdź dostępność',
    epkTitle: 'Press kit (EPK)', epkSub: 'Bio, zdjęcia hi-res, loga i statystyki w jednej paczce.', epkCta: 'Otwórz EPK',
    riderTitle: 'Rider techniczny', riderSub: 'Plan sceny, lista wejść, monitory i hospitality.', riderCta: 'Podgląd ridera',
    photosTitle: 'Zdjęcia prasowe', photosSub: 'Hi-res, gotowe do druku — w galerii.', photosCta: 'Otwórz galerię',
    bookingSubject: 'Zapytanie o termin — {date}',
    bookingSubjectUnavailable: 'Zapytanie o termin — {date} (termin oznaczony jako zajęty)',
    epk: {
      title: 'Press kit (EPK)',
      subtitle: 'Wszystko, czego potrzebuje prasa i organizatorzy — w jednym miejscu.',
      contents: 'Co w środku',
      allLabel: 'Otwórz pełny press kit',
      close: 'Zamknij',
      empty: 'Press kit jest w przygotowaniu — napisz do nas, a wyślemy, co potrzebujesz.',
      bio: 'Bio zespołu', bioMeta: 'Krótkie, średnie i długie',
      photos: 'Zdjęcia prasowe', photosMeta: '{n} zdjęć hi-res',
      logo: 'Logo', logoMeta: 'Pełny kolor, web i druk',
      streaming: 'Streaming i statystyki', streamingMeta: '{n} platform',
      monthlyMeta: '{n} słuchaczy miesięcznie',
      rider: 'Rider techniczny', riderMeta: 'Plan sceny i lista wejść · PDF',
      stagePlot: 'Plan sceny', stagePlotMeta: 'Backline i pozycje · PDF',
    },
    cal: {
      title: 'Sprawdź dostępność',
      subtitle: 'Wybierz termin i wyślij zapytanie — odpowiemy w 48h.',
      open: 'Wolne', booked: 'Zajęte', held: 'Rezerwacja',
      request: 'Zapytaj o ten termin',
      pickPrompt: 'Wybierz termin',
      close: 'Zamknij',
      loadError: 'Nie udało się wczytać kalendarza — podaj termin w formularzu kontaktowym, a potwierdzimy mailem.',
      loading: 'Sprawdzamy wolne terminy…',
      confirmTitle: 'Ten termin wygląda na zajęty',
      confirmBody: 'Mamy już coś zaplanowane na {date}. Możesz mimo to zapytać — odpowiemy tak czy inaczej, a plany czasem się zmieniają.',
      confirmYes: 'Zapytaj mimo to',
      confirmNo: 'Wybierz inny',
      months: ['Styczeń', 'Luty', 'Marzec', 'Kwiecień', 'Maj', 'Czerwiec',
               'Lipiec', 'Sierpień', 'Wrzesień', 'Październik', 'Listopad', 'Grudzień'],
      weekdays: ['Pn', 'Wt', 'Śr', 'Cz', 'Pt', 'So', 'Nd'],
    },
  },
} as const

const t = COPY[lang] ?? COPY.en

// Gate on the module map, never on `=== true` and never on whether content
// exists: getSiteConfig fails open to {} when the API is unreachable mid-build,
// so an absent key has to mean enabled. A disabled module unbuilds its routes,
// so an ungated card here is a dead link the build reports as green.
const enabled = (slug: string) => siteConfig.modules[slug] !== false
const href = (slug: string) => `/${lang}/${slugMap[lang]?.[slug] ?? slug}`

const channels = [
  { key: 'booking', icon: 'calendar', label: t.booking, email: profile.booking_email, note: s.booking_note },
  { key: 'press',   icon: 'quote',    label: t.press,   email: profile.press_email,   note: s.press_note },
  { key: 'general', icon: 'mail',     label: t.general, email: profile.contact_email, note: s.general_note },
].filter(c => c.email)

// ── Press kit contents ────────────────────────────────────────────────────────
//
// Assembled from what the API actually holds, so a band with no stage plot has
// no stage-plot row. Every field is read defensively: a published EPK version is
// a frozen snapshot that predates any field added later.

const epkPageHref = href('epk')
const photosHref = enabled('photos') ? href('photos') : epkPageHref
const photoCount = epk?.press_photos?.length ?? 0
const platformCount = socialLinks.length
const monthly = profile.stat_spotify_monthly ?? 0

const n = (value: number) => value.toLocaleString(dateLocale(lang))

const epkAssets = [
  {
    icon: 'quote',
    title: t.epk.bio,
    meta: t.epk.bioMeta,
    href: epkPageHref,
    isFile: false,
    show: Boolean(profile.bio_short || profile.bio_medium || profile.bio_long),
  },
  {
    icon: 'camera',
    title: t.epk.photos,
    meta: t.epk.photosMeta.replace('{n}', n(photoCount)),
    href: photosHref,
    isFile: false,
    show: photoCount > 0,
  },
  {
    icon: 'star',
    title: t.epk.logo,
    meta: t.epk.logoMeta,
    href: profile.logo_url ?? '',
    isFile: true,
    show: Boolean(profile.logo_url),
  },
  {
    icon: 'spotify',
    title: t.epk.streaming,
    // Monthly listeners are the number promoters ask for; platform count is the
    // fallback when the stat is not filled in.
    meta: monthly > 0
      ? t.epk.monthlyMeta.replace('{n}', n(monthly))
      : t.epk.streamingMeta.replace('{n}', n(platformCount)),
    href: epkPageHref,
    isFile: false,
    show: platformCount > 0 || monthly > 0,
  },
  {
    icon: 'filter',
    title: t.epk.rider,
    meta: t.epk.riderMeta,
    href: profile.tech_rider_url ?? '',
    isFile: true,
    show: Boolean(profile.tech_rider_url),
  },
  {
    icon: 'pin',
    title: t.epk.stagePlot,
    meta: t.epk.stagePlotMeta,
    href: profile.stage_plot_url ?? '',
    isFile: true,
    show: Boolean(profile.stage_plot_url),
  },
]
  // Rows that point at the EPK page disappear with the module, for the same
  // reason the promo cards do — a disabled module unbuilds its route.
  .filter(a => a.show && (a.isFile || a.href !== epkPageHref || enabled('epk')))
  .map(({ show: _show, ...asset }) => asset)

// The booking card opens the calendar rather than navigating, so unlike the
// others it needs no module gate — there is no route for it to point at.
const promo = [
  { icon: 'calendar', title: t.bookTitle,   sub: t.bookSub,   cta: t.bookCta,   href: null,             show: true, isFile: false },
  { icon: 'star',     title: t.epkTitle,    sub: t.epkSub,    cta: t.epkCta,    href: null,             show: enabled('epk') || epkAssets.length > 0, isFile: false },
  // Links the file, not /rider. That route is the token shell — PublicRider
  // reads the last path segment, sees "rider", and renders "Invalid rider link."
  // Every other consumer of this field (the About press card, the EPK asset row)
  // already links the file directly.
  { icon: 'filter',   title: t.riderTitle,  sub: t.riderSub,  cta: t.riderCta,  href: profile.tech_rider_url ?? '', show: Boolean(profile.tech_rider_url), isFile: true },
  { icon: 'camera',   title: t.photosTitle, sub: t.photosSub, cta: t.photosCta, href: href('photos'),   show: enabled('photos'), isFile: false },
].filter(p => p.show)
---

<BaseLayout
  lang={lang}
  alternates={alternates}
  title={`${t.title} — ${profile.name}`}
  description={s.lead || `Get in touch with ${profile.name} for bookings, press inquiries, and more.`}
>
  <!-- HERO -->
  <section class="ct-hero page-x">
    <ThemeSlot name="hero-backdrop" />
    <div class="ct-hero-in">
      {s.kicker && <span class="ct-kicker">{s.kicker}</span>}
      <h1 class="ct-h1">{t.title}</h1>
      {s.lead && <p class="ct-lead">{s.lead}</p>}

      <div class="ct-actions">
        <a href="#contact-form" class="ct-btn ct-btn--fill">
          <Icon name="mail" size={20} color="currentColor" />{t.formTitle}
        </a>
        <button type="button" class="ct-btn ct-btn--ghost" data-open-availability>
          <Icon name="calendar" size={20} color="var(--color-accent)" />{t.bookTitle}
        </button>
      </div>

      <div class="ct-pills">
        {s.reply_time_label && (
          <span class="ct-pill"><Icon name="mail" size={18} color="var(--color-accent)" />{s.reply_time_label}</span>
        )}
        {profile.hometown && (
          <span class="ct-pill"><Icon name="pin" size={18} color="var(--color-accent)" />{profile.hometown}</span>
        )}
      </div>
    </div>
  </section>

  <ThemeSlot name="section-divider" height={16} tone="accent" />

  <!-- FORM + DIRECT CONTACTS -->
  <section class="ct-main page-x" id="contact-form">
    <div class="ct-grid">
      <ContactForm
        client:visible
        copy={{
          title: t.formTitle, subtitle: t.formSub,
          reasonLabel: t.reasonLabel, reasons: t.reasons,
          name: t.name, namePlaceholder: t.namePh,
          email: t.email, emailPlaceholder: t.emailPh,
          subject: t.subject, subjectPlaceholder: t.subjectPh,
          message: t.message, messagePlaceholder: t.messagePh,
          send: t.send, sending: t.sending, sent: t.sent,
          sendAnother: t.sendAnother, error: t.error,
          replyNote: s.reply_time_label ?? '',
          bookingSubject: t.bookingSubject,
          bookingSubjectUnavailable: t.bookingSubjectUnavailable,
          locale: dateLocale(lang),
        }}
      />

      <aside class="ct-aside">
        <div class="ct-aside-head">
          <Icon name="arrow" size={22} color="var(--color-accent)" />
          <h2 class="ct-aside-title">{t.directTitle}</h2>
        </div>

        {channels.map(c => (
          <a href={`mailto:${c.email}`} class="ct-channel">
            <span class="ct-channel-top">
              <Icon name={c.icon} size={20} color="var(--color-accent)" />
              <span class="ct-channel-label">{c.label}</span>
            </span>
            <span class="ct-channel-mail">{c.email}</span>
            {c.note && <span class="ct-channel-note">{c.note}</span>}
          </a>
        ))}

        {socialLinks.length > 0 && (
          <div class="ct-socials">
            <span class="ct-socials-label">{t.follow}</span>
            <SocialLinks links={socialLinks} size="sm" />
          </div>
        )}
      </aside>
    </div>
  </section>

  {promo.length > 0 && (
    <>
      <ThemeSlot name="section-divider" height={14} tone="ink" />
      <section class="ct-promo page-x">
        <div class="ct-promo-head">
          <Icon name="download" size={24} color="var(--color-accent)" />
          <h2 class="ct-promo-title">{t.promoTitle}</h2>
        </div>
        <p class="ct-promo-sub">{t.promoSub}</p>
        <div class="ct-promo-grid" style={`--promo-cols:${promo.length}`}>
          {promo.map(p => {
            const Tag = p.href ? 'a' : 'button'
            return (
              <Tag
                class="ct-card"
                href={p.href ?? undefined}
                target={p.isFile ? '_blank' : undefined}
                rel={p.isFile ? 'noopener' : undefined}
                type={p.href ? undefined : 'button'}
                data-open-availability={p.href || p.icon !== 'calendar' ? undefined : true}
                data-open-epk={p.href || p.icon !== 'star' ? undefined : true}
              >
                <Icon name={p.icon} size={30} color="var(--color-accent)" />
                <span class="ct-card-body">
                  <span class="ct-card-title">{p.title}</span>
                  <span class="ct-card-sub">{p.sub}</span>
                </span>
                <span class="ct-card-cta">{p.cta}<Icon name="chevron" size={16} color="var(--color-accent)" /></span>
              </Tag>
            )
          })}
        </div>
      </section>
    </>
  )}

  <FaqSection module="contact" lang={lang} />

  <!-- client:idle, not client:visible: the modal renders nothing until opened,
       so a visibility trigger would never fire and its document-level click
       listener would never attach. -->
  <AvailabilityModal client:idle copy={t.cal} />
  <EpkModal
    client:idle
    copy={t.epk}
    assets={epkAssets}
    allHref={enabled('epk') ? epkPageHref : null}
  />
</BaseLayout>

<style>
  /* ── Hero ──────────────────────────────────────────────────────────────── */
  .ct-hero {
    position: relative;
    overflow: hidden;
    background: var(--color-inverse);
    color: var(--color-on-inverse);
    padding-block: 54px 58px;
  }
  .ct-hero-in { position: relative; }

  .ct-kicker {
    display: block;
    font: 800 14px/1 var(--font-body);
    letter-spacing: .34em;
    color: var(--color-accent);
  }

  .ct-h1 {
    margin: 16px 0 0;
    font-size: 140px;
    line-height: .82;
  }

  .ct-lead {
    margin: 22px 0 0;
    max-width: 680px;
    font: 500 20px/1.55 var(--font-body);
    color: color-mix(in oklab, var(--color-on-inverse) 82%, transparent);
  }

  .ct-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 28px; }

  .ct-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 24px;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 18px;
    line-height: 1;
    letter-spacing: var(--display-tracking);
    text-transform: var(--display-transform);
    cursor: pointer;
  }
  .ct-btn--fill {
    background: var(--color-accent);
    color: var(--color-on-accent);
    box-shadow: 5px 5px 0 var(--color-on-inverse);
  }
  .ct-btn--ghost {
    background: transparent;
    color: var(--color-on-inverse);
    border: var(--border-width-card) solid var(--color-on-inverse);
  }

  .ct-pills { display: flex; flex-wrap: wrap; gap: 22px; margin-top: 26px; }
  .ct-pill {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font: 700 14px/1 var(--font-body);
    letter-spacing: .06em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--color-on-inverse) 70%, transparent);
  }

  /* ── Form + contacts ───────────────────────────────────────────────────── */
  .ct-main { padding-block: 56px 54px; }
  .ct-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 48px;
    align-items: start;
  }

  .ct-aside { display: flex; flex-direction: column; gap: 16px; }
  .ct-aside-head { display: flex; align-items: center; gap: 10px; margin-bottom: 2px; }
  .ct-aside-title { margin: 0; font-size: 30px; line-height: 1; }

  .ct-channel {
    display: block;
    background: var(--color-inverse);
    color: var(--color-on-inverse);
    padding: 18px 20px;
    text-decoration: none;
    box-shadow: var(--shadow-card-accent);
  }
  .ct-channel-top { display: flex; align-items: center; gap: 11px; margin-bottom: 12px; }
  .ct-channel-label {
    font: 800 11px/1 var(--font-body);
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .ct-channel-mail {
    display: block;
    font: 700 17px/1.2 var(--font-body);
    word-break: break-word;
  }
  .ct-channel-note {
    display: block;
    margin-top: 7px;
    font: 500 13px/1.4 var(--font-body);
    color: color-mix(in oklab, var(--color-on-inverse) 60%, transparent);
  }

  .ct-socials {
    border: var(--border-width-card) solid var(--color-border);
    background: var(--color-surface);
    padding: 18px 20px;
  }
  .ct-socials-label {
    display: block;
    margin-bottom: 14px;
    font: 800 11px/1 var(--font-body);
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--color-subtle);
  }

  /* ── Promoters & press ─────────────────────────────────────────────────── */
  .ct-promo { padding-block: 56px; }
  .ct-promo-head { display: flex; align-items: center; gap: 12px; margin-bottom: 8px; }
  .ct-promo-title { margin: 0; font-size: 56px; line-height: .96; }
  .ct-promo-sub {
    margin: 14px 0 28px;
    max-width: 620px;
    font: 500 17px/1.5 var(--font-body);
    color: var(--color-muted);
  }

  .ct-promo-grid {
    display: grid;
    grid-template-columns: repeat(var(--promo-cols, 4), 1fr);
    gap: 22px;
  }

  .ct-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 22px 20px;
    border: var(--border-width-card) solid var(--color-border);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    color: var(--color-body);
    text-decoration: none;
  }
  /* The booking card is a <button>, which brings its own font, background and
     alignment. Normalising here keeps both tags visually identical. */
  button.ct-card {
    font: inherit;
    text-align: left;
    cursor: pointer;
    appearance: none;
  }

  .ct-card-body { flex: 1; }
  .ct-card-title {
    display: block;
    margin-bottom: 8px;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 23px;
    line-height: 1.02;
    letter-spacing: var(--display-tracking);
    text-transform: var(--display-transform);
  }
  .ct-card-sub { display: block; font: 500 13px/1.45 var(--font-body); color: var(--color-muted); }
  .ct-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
