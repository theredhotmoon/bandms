---
import type { Locale } from '@/types/shared'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHero from '@/components/PageHero.astro'
import SectionHead from '@/components/SectionHead.astro'
import ThemeSlot from '@/components/ThemeSlot.astro'
import Icon from '@/components/Icon.astro'
import FaqSection from '@/components/sections/FaqSection.astro'
import { getEpk, getBandProfile } from '@/lib/cms'
import { fmtDate, formatNumber } from '@/lib/i18n'

interface Props {
  lang: Locale
  alternateHref?: string
}
const { lang, alternateHref } = Astro.props

const [epk, profile] = await Promise.all([getEpk(lang), getBandProfile(lang)])

const COPY = {
  en: {
    kicker: 'ELECTRONIC PRESS KIT',
    lead: 'Everything press and promoters need, on one page.',
    bio: 'Biography', audience: 'Audience', release: 'Featured release',
    shows: 'Upcoming shows', photos: 'Press photos', quotes: 'What people say',
    contact: 'Get in touch',
    formed: 'Formed', based: 'Based in', genres: 'Genres',
    booking: 'Booking', press: 'Press',
    monthly: 'Monthly listeners', instagram: 'Instagram', youtube: 'YouTube',
    tiktok: 'TikTok', facebook: 'Facebook',
    tracklist: 'Tracklist', download: 'Download',
  },
  pl: {
    kicker: 'ELECTRONIC PRESS KIT',
    lead: 'Wszystko, czego potrzebuje prasa i organizatorzy — na jednej stronie.',
    bio: 'Biografia', audience: 'Publiczność', release: 'Wyróżnione wydawnictwo',
    shows: 'Nadchodzące koncerty', photos: 'Zdjęcia prasowe', quotes: 'Co o nas mówią',
    contact: 'Kontakt',
    formed: 'Powstali', based: 'Z miasta', genres: 'Gatunki',
    booking: 'Booking', press: 'Prasa',
    monthly: 'Słuchaczy mies.', instagram: 'Instagram', youtube: 'YouTube',
    tiktok: 'TikTok', facebook: 'Facebook',
    tracklist: 'Lista utworów', download: 'Pobierz',
  },
} as const

const t = COPY[lang] ?? COPY.en

const bio = epk.bio_long || epk.bio_medium || epk.bio_short || ''
const bioParagraphs = bio.replace(/\r\n/g, '\n').split(/\n\s*\n/).map(p => p.trim()).filter(Boolean)

const facts = [
  epk.formation_year ? { label: t.formed, value: String(epk.formation_year) } : null,
  epk.hometown ? { label: t.based, value: epk.hometown } : null,
  epk.genres ? { label: t.genres, value: epk.genres } : null,
].filter((f): f is { label: string; value: string } => f !== null)

// Only figures the band has filled in — a row of zeroes misrepresents reach.
const stats = [
  { label: t.monthly, value: epk.stat_spotify_monthly, icon: 'spotify' },
  { label: t.instagram, value: epk.stat_instagram_followers, icon: 'instagram' },
  { label: t.youtube, value: epk.stat_youtube_subscribers, icon: 'youtube' },
  { label: t.tiktok, value: epk.stat_tiktok_followers, icon: 'star' },
  { label: t.facebook, value: epk.stat_facebook_followers, icon: 'facebook' },
].filter((s): s is typeof s & { value: number } => typeof s.value === 'number' && s.value > 0)

// Guard everything read from a published EPK version: those snapshots are frozen
// and predate any field added since, so a bare access is a build-time throw —
// and one page that throws takes down all of them.
const photos = (epk.press_photos ?? []).filter(p => p.image_url)
const concerts = epk.upcoming_concerts ?? []
const quotes = epk.testimonials ?? []
const socials = epk.social_links ?? []
const release = epk.featured_release ?? null

const contacts = [
  { label: t.booking, email: epk.booking_email },
  { label: t.press, email: epk.press_email },
].filter(c => c.email)
---

<BaseLayout
  lang={lang}
  alternateHref={alternateHref}
  title={`EPK — ${epk.name}`}
  description={t.lead}
  noindex
>
  <PageHero kicker={t.kicker} title={epk.name} lead={t.lead} titleSize={110} leadWidth={640}>
    <div slot="meta" class="epk-facts">
      {facts.map(fact => (
        <span class="epk-fact">
          <span class="epk-fact-label">{fact.label}</span>
          <span class="epk-fact-value">{fact.value}</span>
        </span>
      ))}
    </div>
  </PageHero>

  <ThemeSlot name="section-divider" height={16} tone="accent" />

  {bioParagraphs.length > 0 && (
    <section class="epk-sec page-x">
      <SectionHead icon="quote" title={t.bio} size="sm" />
      <div class="epk-bio">
        {bioParagraphs.map(paragraph => <p>{paragraph}</p>)}
      </div>
    </section>
  )}

  {stats.length > 0 && (
    <section class="epk-stats page-x">
      <SectionHead title={t.audience} size="sm" inverse />
      <div class="epk-stats-grid" style={`--epk-cols:${stats.length}`}>
        {stats.map(stat => (
          <div class="epk-stat">
            <Icon name={stat.icon} size={24} color="var(--color-accent)" />
            <span class="epk-stat-value">{formatNumber(stat.value)}</span>
            <span class="epk-stat-label">{stat.label}</span>
          </div>
        ))}
      </div>
    </section>
  )}

  {release && (
    <section class="epk-sec page-x">
      <SectionHead icon="disc" title={t.release} size="sm" />
      <div class="epk-release">
        <div class="epk-release-cover">
          {release.cover_image
            ? <img src={release.cover_image} alt={release.title} loading="lazy" />
            : <span class="epk-fallback" aria-hidden="true" />}
        </div>
        <div>
          <h3 class="epk-release-title">{release.title}</h3>
          <p class="epk-release-meta">
            {release.type}{release.release_date && ` · ${fmtDate(release.release_date, lang)}`}
          </p>
          {release.description && <p class="epk-release-desc">{release.description}</p>}

          {(release.tracks ?? []).length > 0 && (
            <>
              <p class="epk-sub-label">{t.tracklist}</p>
              <ol class="epk-tracks">
                {release.tracks.map((track, i) => (
                  <li>
                    <span class="epk-track-n">{String(i + 1).padStart(2, '0')}</span>
                    <span>{track.title}</span>
                    <span class="epk-track-dur">{track.duration ?? ''}</span>
                  </li>
                ))}
              </ol>
            </>
          )}
        </div>
      </div>
    </section>
  )}

  {concerts.length > 0 && (
    <section class="epk-sec page-x">
      <SectionHead icon="calendar" title={t.shows} size="sm" />
      <ul class="epk-shows">
        {concerts.map(concert => (
          <li>
            <span class="epk-show-date">{fmtDate(concert.date, lang)}</span>
            <span class="epk-show-venue">
              {concert.venue?.name ?? ''}
              {concert.venue?.city && <span class="epk-show-city">{concert.venue.city}</span>}
            </span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {photos.length > 0 && (
    <>
      <ThemeSlot name="section-divider" height={14} tone="ink" />
      <section class="epk-sec page-x">
        <SectionHead icon="camera" title={t.photos} size="sm" />
        <div class="epk-photos">
          {photos.map(photo => (
            <a class="epk-photo" href={photo.image_url!} target="_blank" rel="noopener">
              <img src={photo.image_url!} alt={photo.caption ?? ''} loading="lazy" />
              <span class="epk-photo-cta">
                <Icon name="download" size={16} color="var(--color-on-accent)" />{t.download}
              </span>
            </a>
          ))}
        </div>
      </section>
    </>
  )}

  {quotes.length > 0 && (
    <section class="epk-sec page-x">
      <SectionHead icon="quote" title={t.quotes} size="sm" />
      <div class="epk-quotes">
        {quotes.map(quote => (
          <blockquote class="epk-quote">
            <p>{quote.quote}</p>
            <cite>
              {quote.name}
              {(quote.role || quote.company) && (
                <span class="epk-quote-role">
                  {[quote.role, quote.company].filter(Boolean).join(', ')}
                </span>
              )}
            </cite>
          </blockquote>
        ))}
      </div>
    </section>
  )}

  {(contacts.length > 0 || socials.length > 0) && (
    <>
      <ThemeSlot name="section-divider" height={14} tone="accent" />
      <section class="epk-sec page-x">
        <SectionHead icon="mail" title={t.contact} size="sm" />

        {contacts.length > 0 && (
          <div class="epk-contacts">
            {contacts.map(contact => (
              <a class="epk-contact" href={`mailto:${contact.email}`}>
                <span>
                  <span class="epk-contact-label">{contact.label}</span>
                  <span class="epk-contact-email">{contact.email}</span>
                </span>
                <Icon name="mail" size={26} color="var(--color-accent)" />
              </a>
            ))}
          </div>
        )}

        {socials.length > 0 && (
          <div class="epk-socials">
            {socials.map(social => (
              <a class="epk-social" href={social.url} target="_blank" rel="noopener">
                <Icon name={social.platform} size={20} color="currentColor" />
                {social.label ?? social.platform}
              </a>
            ))}
          </div>
        )}
      </section>
    </>
  )}

  <FaqSection module="epk" lang={lang} />
</BaseLayout>

<style>
  .epk-sec { padding-block: 48px 44px; position: relative; }

  /* ── Hero facts ────────────────────────────────────────────────────────── */
  .epk-facts { display: flex; flex-wrap: wrap; gap: 28px; margin-top: 26px; }
  .epk-fact { display: block; }
  .epk-fact-label {
    display: block;
    font: 800 10px/1 var(--font-body);
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .epk-fact-value {
    display: block;
    margin-top: 7px;
    font: 700 16px/1.2 var(--font-body);
    color: var(--color-on-inverse);
  }

  /* ── Bio ───────────────────────────────────────────────────────────────── */
  .epk-bio { max-width: 70ch; }
  .epk-bio p {
    margin: 0 0 18px;
    font: 500 18px/1.65 var(--font-body);
    color: var(--color-body);
    text-wrap: pretty;
  }

  /* ── Stats ─────────────────────────────────────────────────────────────── */
  .epk-stats {
    background: var(--color-inverse);
    color: var(--color-on-inverse);
    padding-block: 40px;
  }
  .epk-stats-grid {
    display: grid;
    grid-template-columns: repeat(var(--epk-cols, 5), 1fr);
    gap: 16px;
  }
  .epk-stat {
    border: var(--border-width-card) solid var(--color-on-inverse);
    padding: 18px 16px;
    display: grid;
    justify-items: center;
    gap: 10px;
    text-align: center;
  }
  .epk-stat-value {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 40px;
    line-height: .9;
    letter-spacing: var(--display-tracking);
  }
  .epk-stat-label {
    font: 800 10px/1.3 var(--font-body);
    letter-spacing: .1em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--color-on-inverse) 70%, transparent);
  }

  /* ── Featured release ──────────────────────────────────────────────────── */
  .epk-release { display: grid; grid-template-columns: 280px 1fr; gap: 36px; align-items: start; }

  .epk-release-cover {
    border: var(--border-width-card) solid var(--color-border);
    box-shadow: var(--shadow-card-accent);
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }
  .epk-release-cover img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .epk-fallback {
    display: block;
    width: 100%;
    height: 100%;
    background-image: repeating-linear-gradient(
      45deg,
      color-mix(in oklab, var(--color-page) 92%, black) 0 9px,
      color-mix(in oklab, var(--color-page) 97%, black) 9px 18px
    );
  }

  .epk-release-title { margin: 0 0 8px; font-size: 42px; line-height: .92; }
  .epk-release-meta {
    margin: 0 0 16px;
    font: 800 12px/1 var(--font-body);
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--color-subtle);
  }
  .epk-release-desc {
    margin: 0 0 20px;
    max-width: 60ch;
    font: 500 16px/1.6 var(--font-body);
    color: var(--color-muted);
  }

  .epk-sub-label {
    margin: 0 0 8px;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 20px;
    line-height: 1;
    letter-spacing: var(--display-tracking);
    text-transform: var(--display-transform);
  }

  .epk-tracks {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid color-mix(in oklab, var(--color-ink) 14%, transparent);
  }
  .epk-tracks li {
    display: grid;
    grid-template-columns: 30px 1fr auto;
    gap: 12px;
    align-items: center;
    padding: 9px 0;
    border-bottom: 1.5px solid color-mix(in oklab, var(--color-ink) 10%, transparent);
    font: 600 15px/1.3 var(--font-body);
  }
  .epk-track-n {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 17px;
    line-height: 1;
    color: var(--color-accent);
  }
  .epk-track-dur { font: 600 13px/1 ui-monospace, Menlo, monospace; color: var(--color-subtle); }

  /* ── Shows ─────────────────────────────────────────────────────────────── */
  .epk-shows {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: var(--border-width-card) solid var(--color-border);
  }
  .epk-shows li {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 20px;
    align-items: baseline;
    padding: 14px 4px;
    border-bottom: var(--border-width-card) solid var(--color-border);
  }
  .epk-show-date {
    font: 800 12px/1 var(--font-body);
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .epk-show-venue {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 22px;
    line-height: 1.05;
    letter-spacing: var(--display-tracking);
    text-transform: var(--display-transform);
  }
  .epk-show-city {
    margin-left: 10px;
    font: 600 13px/1 var(--font-body);
    text-transform: none;
    color: var(--color-subtle);
  }

  /* ── Photos ────────────────────────────────────────────────────────────── */
  .epk-photos { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .epk-photo {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: var(--border-width-card) solid var(--color-border);
    background: var(--color-inverse);
  }
  .epk-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .epk-photo-cta {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    background: var(--color-accent);
    color: var(--color-on-accent);
    font: 800 10px/1 var(--font-body);
    letter-spacing: .12em;
    text-transform: uppercase;
    padding: 8px;
  }

  /* ── Quotes ────────────────────────────────────────────────────────────── */
  .epk-quotes { display: grid; grid-template-columns: repeat(2, 1fr); gap: 22px; }
  .epk-quote {
    margin: 0;
    border-left: 6px solid var(--color-accent);
    padding-left: 22px;
  }
  .epk-quote p {
    margin: 0 0 12px;
    font: 500 18px/1.6 var(--font-body);
    color: var(--color-body);
    text-wrap: pretty;
  }
  .epk-quote cite {
    font: 800 12px/1.4 var(--font-body);
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-style: normal;
  }
  .epk-quote-role {
    display: block;
    margin-top: 5px;
    letter-spacing: .06em;
    color: var(--color-subtle);
  }

  /* ── Contact ───────────────────────────────────────────────────────────── */
  .epk-contacts { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .epk-contact {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    background: var(--color-inverse);
    color: var(--color-on-inverse);
    padding: 18px 22px;
  }
  .epk-contact-label {
    display: block;
    font: 800 11px/1 var(--font-body);
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .epk-contact-email { display: block; margin-top: 7px; font: 700 17px/1.2 var(--font-body); word-break: break-word; }

  .epk-socials { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 20px; }
  .epk-social {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 2px solid var(--color-border);
    color: var(--color-body);
    font: 700 14px/1 var(--font-body);
    letter-spacing: .04em;
    text-transform: uppercase;
    padding: 11px 15px;
  }

  /* ── Responsive ────────────────────────────────────────────────────────── */
  @media (max-width: 1100px) {
    .epk-stats-grid { grid-template-columns: repeat(2, 1fr); }
    .epk-release { grid-template-columns: 1fr; gap: 24px; }
    .epk-photos { grid-template-columns: repeat(2, 1fr); }
    .epk-quotes { grid-template-columns: 1fr; }
  }
  @media (max-width: 700px) {
    .epk-sec { padding-block: 32px; }
    .epk-stats-grid { grid-template-columns: 1fr; }
    .epk-release-title { font-size: 30px; }
    .epk-shows li { grid-template-columns: 1fr; gap: 6px; }
    .epk-contacts { grid-template-columns: 1fr; }
    .epk-photos { grid-template-columns: 1fr; }
  }
</style>
