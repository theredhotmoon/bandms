---
import type { Locale } from '@/types/shared'
import type { Alternates } from '@/lib/locales'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHero from '@/components/PageHero.astro'
import { resolveHeroImages } from '@/lib/heroImages'
import SectionHead from '@/components/SectionHead.astro'
import ThemeSlot from '@/components/ThemeSlot.astro'
import VideoGallery from '@/components/VideoGallery.vue'
import FaqSection from '@/components/sections/FaqSection.astro'
import { getClips, getBandProfile, getSiteConfig } from '@/lib/cms'
import { formatGenreKicker } from '@/lib/i18n'
import { toGalleryVideos } from '@/lib/videoGallery'
import { VIDEOS_COPY } from '@bandms/site-copy'
import { moduleCopy, listPaging, siteCopy } from '@/lib/copy'

interface Props {
  lang: Locale
  alternates?: Alternates
}
const { lang, alternates } = Astro.props

const [videos, profile, siteConfig] = await Promise.all([
  getClips(lang).catch(() => []),
  getBandProfile(lang),
  getSiteConfig(lang),
])
const genreKicker = formatGenreKicker(profile.genres)

// Every string on this page: registry defaults for this locale, overridden by
// whatever the band saved in Website Modules → Videos.
const t = moduleCopy(siteConfig, 'videos', VIDEOS_COPY, lang)
// Website Modules → Items per page — see ShowMore.astro / useShowMore().
const { perPage, showMoreLabel } = listPaging(siteConfig, 'videos', lang)

// Every video in the library — the band's own and fans' footage in one
// list, newest first (the API's order), a fan video labelled and credited.
// Same gallery island as the Music page, so both render a video one way.
const galleryVideos = toGalleryVideos(videos, { ...siteCopy(siteConfig, lang), views: t.views })
---

<BaseLayout
  module="videos"
  lang={lang}
  alternates={alternates}
  title={t.title}
  description={t.lead}
>
  <PageHero kicker={genreKicker} title={t.title} lead={t.lead} leadWidth={660} heroImages={resolveHeroImages(siteConfig, 'videos')} />

  <ThemeSlot name="section-divider" height={16} tone="accent" />

  <section class="vs-sec page-content">
    {galleryVideos.length === 0 ? (
      <p class="vs-empty">{t.empty}</p>
    ) : (
      <>
        <SectionHead icon="youtube" title={t.heading} />
        <VideoGallery client:visible videos={galleryVideos} closeLabel={t.close} watchLabel={t.watch} perPage={perPage} showMoreLabel={showMoreLabel} />
      </>
    )}
  </section>

  <FaqSection module="videos" lang={lang} />
</BaseLayout>

<style>
  .vs-sec { padding-block: 56px 52px; position: relative; }
  .vs-empty { margin: 0; font: 500 17px/1.5 var(--font-body); color: var(--color-muted); }

  @media (max-width: 700px) {
    .vs-sec { padding-block: 36px; }
  }
</style>
