---
import type { Locale } from '@/types/shared'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHero from '@/components/PageHero.astro'
import SectionHead from '@/components/SectionHead.astro'
import ThemeSlot from '@/components/ThemeSlot.astro'
import VideoGallery from '@/components/VideoGallery.vue'
import FaqSection from '@/components/sections/FaqSection.astro'
import { getMusicVideos, getBandProfile } from '@/lib/cms'
import { youtubeEmbedUrl, youtubeThumbnail, formatNumber } from '@/lib/i18n'

interface Props {
  lang: Locale
  alternateHref?: string
}
const { lang, alternateHref } = Astro.props

const [videos, profile] = await Promise.all([
  getMusicVideos().catch(() => []),
  getBandProfile(lang),
])

const COPY = {
  en: {
    kicker: 'SKA · SKA-JAZZ · ROCKSTEADY',
    title: 'Videos',
    lead: 'Live sets, official videos and clips from the road.',
    heading: 'Music videos',
    empty: 'No videos yet — check back soon.',
    views: 'views',
    close: 'Close',
    watch: 'Watch on YouTube',
  },
  pl: {
    kicker: 'SKA · SKA-JAZZ · ROCKSTEADY',
    title: 'Teledyski',
    lead: 'Koncerty, oficjalne teledyski i klipy z trasy.',
    heading: 'Teledyski',
    empty: 'Brak teledysków — wkrótce.',
    views: 'wyświetleń',
    close: 'Zamknij',
    watch: 'Zobacz na YouTube',
  },
} as const

const t = COPY[lang] ?? COPY.en

// Same shape the Music page builds, so both pages share one gallery island
// rather than each rendering videos its own way.
const galleryVideos = [...videos]
  .sort((a, b) => a.sort_order - b.sort_order)
  .map(v => ({
    id: v.id,
    title: v.og_title ?? v.title,
    kind: v.channel_name ?? '',
    embedUrl: youtubeEmbedUrl(v.video_url),
    watchUrl: v.video_url,
    thumb: v.og_image ?? youtubeThumbnail(v.video_url),
    duration: v.duration,
    meta: [
      v.view_count ? `${formatNumber(v.view_count)} ${t.views}` : null,
      v.published_at ? v.published_at.slice(0, 4) : null,
    ]
      .filter(Boolean)
      .join(' · '),
  }))
---

<BaseLayout
  lang={lang}
  alternateHref={alternateHref}
  title={`${t.title} — ${profile.name}`}
  description={t.lead}
>
  <PageHero kicker={t.kicker} title={t.title} lead={t.lead} leadWidth={660} />

  <ThemeSlot name="section-divider" height={16} tone="accent" />

  <section class="vs-sec page-x">
    {galleryVideos.length === 0 ? (
      <p class="vs-empty">{t.empty}</p>
    ) : (
      <>
        <SectionHead icon="youtube" title={t.heading} />
        <VideoGallery client:visible videos={galleryVideos} closeLabel={t.close} watchLabel={t.watch} />
      </>
    )}
  </section>

  <FaqSection module="videos" lang={lang} />
</BaseLayout>

<style>
  .vs-sec { padding-block: 56px 52px; position: relative; }
  .vs-empty { margin: 0; font: 500 17px/1.5 var(--font-body); color: var(--color-muted); }

  @media (max-width: 700px) {
    .vs-sec { padding-block: 36px; }
  }
</style>
