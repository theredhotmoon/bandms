---
import type { Locale } from '@/types/shared'
import type { Alternates } from '@/lib/locales'
import { getSlugMap } from '@/lib/slugs'
import { formatGenreKicker } from '@/lib/i18n'

interface Props {
  lang: Locale
  alternates: Alternates
}
const { lang, alternates } = Astro.props
const slugMap = await getSlugMap()

import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHero from '@/components/PageHero.astro'
import { resolveHeroImages } from '@/lib/heroImages'
import NewsFilter from '@/components/NewsFilter.vue'
import { BUILD_STARTED_AT, getAllPosts, getBandProfile, getFeaturedPost, getPostBatch, getSiteConfig } from '@/lib/cms'
import FaqSection from '@/components/sections/FaqSection.astro'
import { POSTS_COPY } from '@bandms/site-copy'
import { moduleCopy, listPaging } from '@/lib/copy'

const ACCENT = 'var(--color-accent)'

const [allPosts, profile, siteConfig, featured] = await Promise.all([
  getAllPosts(lang),
  getBandProfile(lang),
  getSiteConfig(lang),
  getFeaturedPost(lang),
])
// Every string on this page and its island: registry defaults for this
// locale, overridden by whatever the band saved in Website Modules → News.
const t = moduleCopy(siteConfig, 'posts', POSTS_COPY, lang)
// Website Modules → Items per page — see useShowMore().
const paging = listPaging(siteConfig, 'posts', lang)
const genreKicker = formatGenreKicker(profile.genres)

// Only the first batch of the grid is baked; "Show more" and the filters
// fetch the rest from the API (postFeed.ts), so the page stays the same size
// however many posts the band writes. "Default" (no Items per page) bakes
// them all, as before.
const firstBatch = paging.perPage
  ? await getPostBatch({ lang, limit: paging.perPage, exclude: featured?.id })
  : { posts: allPosts.filter(p => p.id !== featured?.id), nextCursor: null }

// The filter chips: every tag on a published post, which the first batch
// alone would not cover. Read at build time; only the list reaches the page.
const tagMap = new Map<number, { id: number; slug: string; name: string }>()
allPosts.forEach(p => p.tags.forEach(t => tagMap.set(t.id, { id: t.id, slug: t.slug, name: t.name })))
const tags = [...tagMap.values()]
---

<BaseLayout
  module="posts"
  lang={lang}
  alternates={alternates}
  title={t.title}
  description={t.lead}
>
  <div class="ss">

    <!-- ── HERO ──────────────────────────────────────────────── -->
    <PageHero
      kicker={genreKicker}
      title={t.title}
      lead={t.lead}
      heroImages={resolveHeroImages(siteConfig, 'posts')}
    />

    <!-- checker strip divider -->
    <div class="checker-strip" aria-hidden="true"></div>

    <!-- ── FILTER + POSTS (Vue island) ───────────────────────── -->
    <NewsFilter
      featured={featured}
      initialPosts={firstBatch.posts}
      initialCursor={firstBatch.nextCursor}
      builtAt={BUILD_STARTED_AT}
      tags={tags}
      accent={ACCENT}
      postHrefBase={`/${lang}/${slugMap[lang].posts}`}
      lang={lang}
      perPage={paging.perPage}
      showMoreLabel={paging.showMoreLabel}
      showMoreLoading={paging.showMoreLoading}
      showMoreError={paging.showMoreError}
      listLoadError={paging.listLoadError}
      tryAgainLabel={paging.tryAgainLabel}
      copy={{
        all: t.filterAll, searchPlaceholder: t.searchPlaceholder, searchLabel: t.searchLabel,
        noMatch: t.noMatch, featured: t.featured, readFull: t.readFull, event: t.event,
      }}
      client:idle
    />
  </div>
  <FaqSection module="posts" lang={lang} />
</BaseLayout>

<style>
  .ss {
    --paper: var(--color-page);
    --ink:   var(--color-ink);
    --acc:   var(--color-accent);
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-body);
    position: relative;
  }

  /* Grain overlay */

  /* checker strip */
  .checker-strip {
    height: 16px;
    background-image: repeating-conic-gradient(var(--acc) 0% 25%, var(--paper) 0% 50%);
    background-size: 31px 16px;
  }

</style>
