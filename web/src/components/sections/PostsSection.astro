---
import type { Locale } from '@/types/shared'
import type { Alternates } from '@/lib/locales'
import { getSlugMap } from '@/lib/slugs'
import { postSlug, formatGenreKicker } from '@/lib/i18n'

interface Props {
  lang: Locale
  alternates: Alternates
}
const { lang, alternates } = Astro.props
const slugMap = await getSlugMap()

import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHero from '@/components/PageHero.astro'
import { resolveHeroImages } from '@/lib/heroImages'
import NewsFilter from '@/components/NewsFilter.vue'
import { getPosts, getBandProfile, getSiteConfig } from '@/lib/cms'
import FaqSection from '@/components/sections/FaqSection.astro'

const ACCENT = 'var(--color-accent)'

const [firstPage, profile, siteConfig] = await Promise.all([
  getPosts(lang, 1),
  getBandProfile(lang),
  getSiteConfig(lang),
])
const s = siteConfig.module_config?.posts?.settings ?? {}
const genreKicker = formatGenreKicker(profile.genres)

let allPosts = [...firstPage.data]
if (firstPage.meta.last_page > 1) {
  const extra = await Promise.all(
    Array.from({ length: firstPage.meta.last_page - 1 }, (_, i) => getPosts(lang, i + 2))
  )
  extra.forEach(r => allPosts.push(...r.data))
}
const postsWithSlug = allPosts.map(p => ({ ...p, slug: postSlug(p, lang) }))
---

<BaseLayout
  lang={lang}
  alternates={alternates}
  title={`News — ${profile.name}`}
  description="Studio updates, fresh dates and stories from the road."
>
  <div class="ss">

    <!-- ── HERO ──────────────────────────────────────────────── -->
    <PageHero
      kicker={genreKicker}
      title={s.title || 'News'}
      lead={s.lead || 'Studio updates, fresh dates and stories from the road.'}
      heroImages={resolveHeroImages(siteConfig, 'posts')}
    />

    <!-- checker strip divider -->
    <div class="checker-strip" aria-hidden="true"></div>

    <!-- ── FILTER + POSTS (Vue island) ───────────────────────── -->
    <NewsFilter
      posts={postsWithSlug}
      accent={ACCENT}
      postHrefBase={`/${lang}/${slugMap[lang].posts}`}
      client:idle
    />
  </div>
  <FaqSection module="posts" lang={lang} />
</BaseLayout>

<style>
  .ss {
    --paper: var(--color-page);
    --ink:   var(--color-ink);
    --acc:   var(--color-accent);
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-body);
    position: relative;
  }

  /* Grain overlay */

  /* checker strip */
  .checker-strip {
    height: 16px;
    background-image: repeating-conic-gradient(var(--acc) 0% 25%, var(--paper) 0% 50%);
    background-size: 31px 16px;
  }

</style>
