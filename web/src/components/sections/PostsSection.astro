---
import type { Locale } from '@/types/shared'
import type { Alternates } from '@/lib/locales'
import { getSlugMap } from '@/lib/slugs'
import { postSlug, formatGenreKicker } from '@/lib/i18n'

interface Props {
  lang: Locale
  alternates: Alternates
}
const { lang, alternates } = Astro.props
const slugMap = await getSlugMap()

import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHero from '@/components/PageHero.astro'
import { resolveHeroImages } from '@/lib/heroImages'
import NewsFilter from '@/components/NewsFilter.vue'
import { getAllPosts, getBandProfile, getSiteConfig } from '@/lib/cms'
import FaqSection from '@/components/sections/FaqSection.astro'
import { POSTS_COPY } from '@bandms/site-copy'
import { moduleCopy } from '@/lib/copy'

const ACCENT = 'var(--color-accent)'

const [allPosts, profile, siteConfig] = await Promise.all([
  getAllPosts(lang),
  getBandProfile(lang),
  getSiteConfig(lang),
])
// Every string on this page and its island: registry defaults for this
// locale, overridden by whatever the band saved in Website Modules → News.
const t = moduleCopy(siteConfig, 'posts', POSTS_COPY, lang)
const genreKicker = formatGenreKicker(profile.genres)

const postsWithSlug = allPosts.map(p => ({ ...p, slug: postSlug(p, lang) }))
---

<BaseLayout
  lang={lang}
  alternates={alternates}
  title={t.title}
  description={t.lead}
>
  <div class="ss">

    <!-- ── HERO ──────────────────────────────────────────────── -->
    <PageHero
      kicker={genreKicker}
      title={t.title}
      lead={t.lead}
      heroImages={resolveHeroImages(siteConfig, 'posts')}
    />

    <!-- checker strip divider -->
    <div class="checker-strip" aria-hidden="true"></div>

    <!-- ── FILTER + POSTS (Vue island) ───────────────────────── -->
    <NewsFilter
      posts={postsWithSlug}
      accent={ACCENT}
      postHrefBase={`/${lang}/${slugMap[lang].posts}`}
      lang={lang}
      copy={{
        all: t.filterAll, searchPlaceholder: t.searchPlaceholder, searchLabel: t.searchLabel,
        noMatch: t.noMatch, featured: t.featured, readFull: t.readFull, event: t.event,
      }}
      client:idle
    />
  </div>
  <FaqSection module="posts" lang={lang} />
</BaseLayout>

<style>
  .ss {
    --paper: var(--color-page);
    --ink:   var(--color-ink);
    --acc:   var(--color-accent);
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-body);
    position: relative;
  }

  /* Grain overlay */

  /* checker strip */
  .checker-strip {
    height: 16px;
    background-image: repeating-conic-gradient(var(--acc) 0% 25%, var(--paper) 0% 50%);
    background-size: 31px 16px;
  }

</style>
