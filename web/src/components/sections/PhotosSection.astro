---
import type { Locale } from '@/types/shared'
import type { Alternates } from '@/lib/locales'
import BaseLayout from '@/layouts/BaseLayout.astro'
import ThemeSlot from '@/components/ThemeSlot.astro'
import PageHero from '@/components/PageHero.astro'
import { resolveHeroImages } from '@/lib/heroImages'
import GalleryBrowser from '@/components/GalleryBrowser.vue'
import FaqSection from '@/components/sections/FaqSection.astro'
import { getAlbums, getBandProfile, getSiteConfig } from '@/lib/cms'
import { fmtDateShort, formatGenreKicker } from '@/lib/i18n'
import { PHOTOS_COPY } from '@bandms/site-copy'
import { moduleCopy, listPaging } from '@/lib/copy'
import { getSlugMap } from '@/lib/slugs'
import { albumHref, isAlbumOnSite } from '@/lib/albums'

interface Props {
  lang: Locale
  alternates?: Alternates
}
const { lang, alternates } = Astro.props

const [albums, profile, siteConfig, slugMap] = await Promise.all([getAlbums(lang), getBandProfile(lang), getSiteConfig(lang), getSlugMap()])
const genreKicker = formatGenreKicker(profile.genres)

// Every string on this page: registry defaults for this locale, overridden by
// whatever the band saved in Website Modules → Gallery.
const t = moduleCopy(siteConfig, 'photos', PHOTOS_COPY, lang)
// Website Modules → Items per page — see ShowMore.astro / useShowMore().
const { perPage, showMoreLabel } = listPaging(siteConfig, 'photos', lang)

// Unpublished albums and empty ones are both invisible: their pages are not
// built (isAlbumOnSite() is the rule the album route uses too), and a card
// leading to an empty album is worse than an absent card.
const visible = albums.filter(isAlbumOnSite)

const galleryAlbums = visible.map(album => {
  const shotAt = album.venue?.name ?? ''
  const when = album.taken_at ? fmtDateShort(album.taken_at, lang) : ''
  // The design's meta line is "category · date". With no tags it collapses to
  // just the date rather than leaving a dangling separator.
  const category = album.tags?.[0]?.name ?? ''

  const photos = (album.photos ?? []).filter(photo => photo.image_url)

  return {
    id: album.id,
    title: album.title,
    // Every visible album has a page, and this is the Gallery module's own
    // page, so the module is on: the href is never null here.
    href: albumHref(album, lang, slugMap, siteConfig.modules) ?? '#',
    categories: (album.tags ?? []).map(tag => tag.slug),
    metaLine: [category, when].filter(Boolean).join(' · '),
    shotAt,
    coverUrl: album.cover_url ?? photos[0]?.image_url ?? null,
    photoCount: photos.length,
    hasPressReady: photos.some(photo => photo.epk_featured ?? false),
  }
})

// Filter chips come from the tags actually in use, deduped, so switching to a
// category can never yield an empty grid.
const categories = Object.values(
  visible
    .flatMap(a => a.tags ?? [])
    .reduce<Record<string, { slug: string; label: string }>>((acc, tag) => {
      acc[tag.slug] ??= { slug: tag.slug, label: tag.name }
      return acc
    }, {}),
)
---

<BaseLayout
  module="photos"
  lang={lang}
  alternates={alternates}
  title={t.title}
  description={t.lead}
>
  <!-- HERO -->
  <PageHero
    kicker={genreKicker}
    title={t.title}
    lead={t.lead}
    heroImages={resolveHeroImages(siteConfig, 'photos')}
  />

  <ThemeSlot name="section-divider" height={16} tone="accent" />

  <section class="gl-sec page-content">
    {galleryAlbums.length === 0 ? (
      <p class="gl-none">{t.none}</p>
    ) : (
      <GalleryBrowser
        client:visible
        albums={galleryAlbums}
        categories={categories}
        perPage={perPage}
        showMoreLabel={showMoreLabel}
        copy={{
          all: t.all,
          photos: t.photos,
          pressReady: t.pressReady,
          shotAt: t.shotAt,
          empty: t.empty,
        }}
      />
    )}
  </section>

  <FaqSection module="photos" lang={lang} />
</BaseLayout>

<style>

  .gl-sec { padding-block: 40px 56px; position: relative; }

  .gl-none { margin: 0; font: 500 17px/1.5 var(--font-body); color: var(--color-muted); }

  @media (max-width: 1100px) {
  }
  @media (max-width: 700px) {
    .gl-sec { padding-block: 28px 36px; }
  }
</style>
