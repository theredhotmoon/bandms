---
import type { Locale } from '@/types/shared'
import { getSlugMap } from '@/lib/slugs'

interface Props {
  lang: Locale
  alternateHref: string
}
const { lang, alternateHref } = Astro.props
const slugMap = await getSlugMap()

import BaseLayout from '@/layouts/BaseLayout.astro'
import PhotoLightbox from '@/components/PhotoLightbox.vue'
import { getAlbums, getBandProfile } from '@/lib/cms'
import { fmtDateShort } from '@/lib/i18n'
import FaqSection from '@/components/sections/FaqSection.astro'

const [albums, profile] = await Promise.all([getAlbums(), getBandProfile(lang)])

// Only published albums with at least one photo
const visible = albums.filter(a => a.published_at && a.photo_count > 0)
---

<BaseLayout
  lang={lang}
  alternateHref={alternateHref}
  title={`Photos — ${profile.name}`}
  description={`Photo gallery of ${profile.name} — concerts, behind the scenes, and more.`}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 pt-16 pb-24">
    <div class="mb-12">
      <div class="accent-line mb-4" />
      <h1 class="text-4xl font-black text-body sm:text-5xl">Photos</h1>
    </div>

    {visible.length === 0 && (
      <p class="text-muted">No photos yet — check back soon.</p>
    )}

    {visible.map(album => (
      <section class="mb-14">
        <div class="flex items-baseline justify-between mb-4">
          <div>
            <h2 class="text-xl font-bold text-body">{album.title}</h2>
            {album.taken_at && (
              <p class="text-sm text-muted mt-0.5">{fmtDateShort(album.taken_at, 'en')}</p>
            )}
            {album.description && (
              <p class="text-sm text-muted mt-1">{album.description}</p>
            )}
          </div>
          <span class="text-xs text-subtle">{album.photo_count} photos</span>
        </div>

        <PhotoLightbox
          client:visible
          photos={(album.photos ?? []).map(p => ({ src: p.image_url ?? '', caption: p.caption }))}
        />
      </section>
    ))}
  </div>
  <FaqSection module="photos" lang={lang} />
</BaseLayout>
