---
import type { Locale } from '@/types/shared'
import type { Alternates } from '@/lib/locales'
import BaseLayout from '@/layouts/BaseLayout.astro'
import ThemeSlot from '@/components/ThemeSlot.astro'
import PageHero from '@/components/PageHero.astro'
import { resolveHeroImages } from '@/lib/heroImages'
import GalleryBrowser from '@/components/GalleryBrowser.vue'
import FaqSection from '@/components/sections/FaqSection.astro'
import { getAlbums, getBandProfile, getSiteConfig } from '@/lib/cms'
import { fmtDateShort } from '@/lib/i18n'

interface Props {
  lang: Locale
  alternates?: Alternates
}
const { lang, alternates } = Astro.props

const [albums, profile, siteConfig] = await Promise.all([getAlbums(), getBandProfile(lang), getSiteConfig(lang)])
const s = siteConfig.module_config?.photos?.settings ?? {}

const COPY = {
  en: {
    kicker: 'SKA · SKA-JAZZ · ROCKSTEADY',
    title: 'Gallery',
    lead: 'Brass in the air, feet off the floor. Live shots, backstage moments and studio days.',
    all: 'All',
    photos: 'photos',
    pressReady: 'Press-ready',
    shotAt: 'Shot at',
    close: 'Close', prev: 'Previous photo', next: 'Next photo',
    empty: 'Nothing in this category yet.',
    none: 'No photos yet — check back soon.',
  },
  pl: {
    kicker: 'SKA · SKA-JAZZ · ROCKSTEADY',
    title: 'Galeria',
    lead: 'Dęciaki w powietrzu, stopy w górze. Zdjęcia z koncertów, backstage’u i studia.',
    all: 'Wszystkie',
    photos: 'zdjęć',
    pressReady: 'Do prasy',
    shotAt: 'Zdjęcia z',
    close: 'Zamknij', prev: 'Poprzednie zdjęcie', next: 'Następne zdjęcie',
    empty: 'Brak zdjęć w tej kategorii.',
    none: 'Brak zdjęć — wkrótce.',
  },
} as const

const t = COPY[lang] ?? COPY.en

// Unpublished albums and empty ones are both invisible: a gallery card that
// opens an empty lightbox is worse than an absent card.
const visible = albums.filter(a => a.published_at && (a.photos?.length ?? 0) > 0)

const galleryAlbums = visible.map(album => {
  const shotAt = album.venue?.name ?? ''
  const when = album.taken_at ? fmtDateShort(album.taken_at, lang) : ''
  // The design's meta line is "category · date". With no tags it collapses to
  // just the date rather than leaving a dangling separator.
  const category = album.tags?.[0]?.name ?? ''

  return {
    id: album.id,
    title: album.title,
    categories: (album.tags ?? []).map(tag => tag.slug_en),
    metaLine: [category, when].filter(Boolean).join(' · '),
    shotAt,
    coverUrl: album.cover_url ?? album.photos?.[0]?.image_url ?? null,
    photos: [...(album.photos ?? [])]
      .sort((a, b) => a.sort_order - b.sort_order)
      // A photo with no URL cannot be shown; it would open a broken lightbox.
      .filter(photo => photo.image_url)
      .map(photo => ({
        id: photo.id,
        src: photo.image_url as string,
        caption: photo.caption,
        isPressReady: photo.epk_featured ?? false,
      })),
  }
})

// Filter chips come from the tags actually in use, deduped, so switching to a
// category can never yield an empty grid.
const categories = Object.values(
  visible
    .flatMap(a => a.tags ?? [])
    .reduce<Record<string, { slug: string; label: string }>>((acc, tag) => {
      acc[tag.slug_en] ??= { slug: tag.slug_en, label: tag.name }
      return acc
    }, {}),
)
---

<BaseLayout
  lang={lang}
  alternates={alternates}
  title={`${t.title} — ${profile.name}`}
  description={t.lead}
>
  <!-- HERO -->
  <PageHero
    kicker={t.kicker}
    title={s.title || t.title}
    lead={s.lead || t.lead}
    heroImages={resolveHeroImages(siteConfig, 'photos')}
  />

  <ThemeSlot name="section-divider" height={16} tone="accent" />

  <section class="gl-sec page-x">
    {galleryAlbums.length === 0 ? (
      <p class="gl-none">{t.none}</p>
    ) : (
      <GalleryBrowser
        client:visible
        albums={galleryAlbums}
        categories={categories}
        copy={{
          all: t.all,
          photos: t.photos,
          pressReady: t.pressReady,
          shotAt: t.shotAt,
          close: t.close,
          prev: t.prev,
          next: t.next,
          empty: t.empty,
        }}
      />
    )}
  </section>

  <FaqSection module="photos" lang={lang} />
</BaseLayout>

<style>

  .gl-sec { padding-block: 40px 56px; position: relative; }

  .gl-none { margin: 0; font: 500 17px/1.5 var(--font-body); color: var(--color-muted); }

  @media (max-width: 1100px) {
  }
  @media (max-width: 700px) {
    .gl-sec { padding-block: 28px 36px; }
  }
</style>
