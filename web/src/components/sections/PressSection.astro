---
import type { Locale } from '@/types/shared'
import type { Alternates } from '@/lib/locales'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHero from '@/components/PageHero.astro'
import SectionHead from '@/components/SectionHead.astro'
import ThemeSlot from '@/components/ThemeSlot.astro'
import FaqSection from '@/components/sections/FaqSection.astro'
import { getPressReleases, getBandProfile } from '@/lib/cms'
import { fmtDateShort } from '@/lib/i18n'

interface Props {
  lang: Locale
  alternates?: Alternates
}
const { lang, alternates } = Astro.props

const [press, profile] = await Promise.all([
  getPressReleases().catch(() => []),
  getBandProfile(lang),
])

const COPY = {
  en: {
    kicker: 'SKA · SKA-JAZZ · ROCKSTEADY',
    title: 'Press',
    lead: 'What the papers, blogs and radio have said about us.',
    featured: 'Featured', coverage: 'Coverage',
    empty: 'No press coverage yet.',
    read: 'Read',
  },
  pl: {
    kicker: 'SKA · SKA-JAZZ · ROCKSTEADY',
    title: 'Prasa',
    lead: 'Co pisały o nas gazety, blogi i radio.',
    featured: 'Wyróżnione', coverage: 'Publikacje',
    empty: 'Brak publikacji prasowych.',
    read: 'Czytaj',
  },
} as const

const t = COPY[lang] ?? COPY.en

const sorted = [...press].sort((a, b) =>
  (b.published_at ?? b.created_at).localeCompare(a.published_at ?? a.created_at),
)
const featured = sorted.filter(p => p.featured)
const rest = sorted.filter(p => !p.featured)

// The publication name is the most useful label; the URL host stands in when no
// og:site_name was scraped, so a row is never nameless.
const siteOf = (item: (typeof sorted)[number]) => {
  if (item.og_site_name) return item.og_site_name
  try {
    return new URL(item.url).host.replace(/^www\./, '')
  } catch {
    return ''
  }
}
---

<BaseLayout
  lang={lang}
  alternates={alternates}
  title={`${t.title} — ${profile.name}`}
  description={t.lead}
>
  <PageHero kicker={t.kicker} title={t.title} lead={t.lead} leadWidth={620} />

  <ThemeSlot name="section-divider" height={16} tone="accent" />

  <section class="pr-sec page-x">
    {sorted.length === 0 && <p class="pr-empty">{t.empty}</p>}

    {featured.length > 0 && (
      <>
        <SectionHead icon="star" title={t.featured} size="sm" />
        <div class="pr-featured">
          {featured.map(item => (
            <a class="pr-card" href={item.url} target="_blank" rel="noopener">
              {item.og_image && (
                <span class="pr-card-img">
                  <img src={item.og_image} alt={item.og_title ?? ''} loading="lazy" />
                </span>
              )}
              <span class="pr-card-body">
                <span class="pr-site">{siteOf(item)}</span>
                <span class="pr-card-title">{item.og_title ?? item.url}</span>
                {item.og_description && <span class="pr-card-desc">{item.og_description}</span>}
                <span class="pr-card-foot">
                  {item.published_at && <span>{fmtDateShort(item.published_at, lang)}</span>}
                  <span class="pr-read">{t.read} →</span>
                </span>
              </span>
            </a>
          ))}
        </div>
      </>
    )}

    {rest.length > 0 && (
      <div class="pr-rest">
        <SectionHead icon="quote" title={t.coverage} size="sm" />
        <ul class="pr-list">
          {rest.map(item => (
            <li>
              <a class="pr-row" href={item.url} target="_blank" rel="noopener">
                <span>
                  <span class="pr-site pr-site--row">{siteOf(item)}</span>
                  <span class="pr-row-title">{item.og_title ?? item.url}</span>
                </span>
                <span class="pr-row-meta">
                  {item.published_at && <span>{fmtDateShort(item.published_at, lang)}</span>}
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)"
                       stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M14 4h6v6" /><path d="M20 4l-9 9" />
                    <path d="M19 14v5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
                  </svg>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>

  <FaqSection module="press" lang={lang} />
</BaseLayout>

<style>
  .pr-sec { padding-block: 56px 52px; position: relative; }
  .pr-empty { margin: 0; font: 500 17px/1.5 var(--font-body); color: var(--color-muted); }

  /* Shared: the publication name, always in accent. */
  .pr-site {
    display: block;
    font: 800 11px/1 var(--font-body);
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  /* ── Featured cards ────────────────────────────────────────────────────── */
  .pr-featured { display: grid; grid-template-columns: repeat(2, 1fr); gap: 22px; }

  .pr-card {
    border: var(--border-width-card) solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-body);
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
  }

  .pr-card-img {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: var(--border-width-card) solid var(--color-border);
    background: var(--color-inverse);
  }
  .pr-card-img img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .pr-card-body { display: block; padding: 18px 20px 20px; }

  .pr-card-title {
    display: block;
    margin: 9px 0 10px;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 24px;
    line-height: 1.04;
    letter-spacing: var(--display-tracking);
    text-transform: var(--display-transform);
  }

  .pr-card-desc {
    display: block;
    margin-bottom: 14px;
    font: 500 14px/1.5 var(--font-body);
    color: var(--color-muted);
  }

  .pr-card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font: 700 12px/1 var(--font-body);
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--color-subtle);
  }
  .pr-read { color: var(--color-accent); }

  /* ── Coverage list ─────────────────────────────────────────────────────── */
  .pr-rest { margin-top: 40px; }

  .pr-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: var(--border-width-card) solid var(--color-border);
  }
  .pr-list li { border-bottom: var(--border-width-card) solid var(--color-border); }

  .pr-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 18px 4px;
    color: var(--color-body);
  }
  .pr-site--row { margin-bottom: 7px; }

  .pr-row-title {
    display: block;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 24px;
    line-height: 1.04;
    letter-spacing: var(--display-tracking);
    text-transform: var(--display-transform);
  }

  .pr-row-meta {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    flex: none;
    font: 700 12px/1 var(--font-body);
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--color-subtle);
  }

  @media (max-width: 900px) {
    .pr-featured { grid-template-columns: 1fr; }
  }
  @media (max-width: 700px) {
    .pr-sec { padding-block: 36px; }
    .pr-card-title, .pr-row-title { font-size: 19px; }
    .pr-row-meta { gap: 10px; }
  }
</style>
