---
import type { Locale } from '@/types/shared'
import { hreflangLinks, type Alternates } from '@/lib/locales'

export interface Props {
  title: string
  description: string
  image?: string | null
  canonical?: string
  noindex?: boolean
  structuredData?: object
  lang?: Locale
  /** Path per locale for this page, from the route. */
  alternates?: Alternates
}

const {
  title, description, image, canonical, noindex = false, structuredData,
  lang = 'en', alternates = {},
} = Astro.props
const site = Astro.site?.toString().replace(/\/$/, '') ?? ''
const ogImage = image ? (image.startsWith('http') ? image : `${site}${image}`) : `${site}/og-default.png`
const canonicalUrl = canonical ?? Astro.url.href
---

<!-- Fonts: Anton (display) + Archivo (body) — used across all pages and Header -->
<!-- Charset & viewport -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<!-- Primary meta -->
<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex,nofollow" />}
<link rel="canonical" href={canonicalUrl} />

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<!-- Open Graph -->
<meta property="og:type"        content="website" />
<meta property="og:url"         content={canonicalUrl} />
<meta property="og:title"       content={title} />
<meta property="og:description" content={description} />
<meta property="og:image"       content={ogImage} />
<meta property="og:site_name"   content="Skanking Storks" />

<!-- Twitter Card -->
<meta name="twitter:card"        content="summary_large_image" />
<meta name="twitter:title"       content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image"       content={ogImage} />

<!--
  Hreflang, one row per registered locale plus x-default.

  Every href comes from the route's own alternates map. This used to be derived
  from Astro.url alone -- hreflang="pl" was `${site}/pl${pathname}` -- which
  described a "/en is unprefixed" URL scheme the site had already stopped using.
  On /en/ it emitted /pl/en/, and on /pl/ it labelled /pl/ as the English page.
  Well-formed markup, green build, wrong on every page.
-->
{hreflangLinks(alternates, { site, currentLocale: lang, currentPath: Astro.url.pathname }).map(
  ({ hreflang, href }) => <link rel="alternate" hreflang={hreflang} href={href} />
)}

<!-- Structured data -->
{structuredData && (
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
)}
