---
/**
 * The design's icon set, ported from variants/shared.jsx.
 *
 * Every glyph is drawn on a 24×24 grid with a 1.7 stroke and round caps, so
 * they sit together at any size. Shapes that read better filled (star, play,
 * platform marks) set fill and clear stroke individually.
 *
 * `color` defaults to currentColor so an icon inherits the text colour of
 * whatever it sits in — which is what keeps it themeable without passing tokens
 * down through every call site.
 */
interface Props {
  name: string
  size?: number
  color?: string
  class?: string
}

const { name, size = 24, color = 'currentColor', class: className } = Astro.props
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke={color}
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  style="display:block"
  aria-hidden="true"
>
  {name === 'instagram' && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.3" cy="6.7" r="1.2" fill={color} stroke="none" />
    </>
  )}
  {name === 'facebook' && (
    <path d="M14 8.5h2.2V5.4h-2.6c-2.3 0-3.6 1.4-3.6 3.7v1.7H8v3h2v6h3.1v-6h2.3l.4-3h-2.7V9.4c0-.6.3-.9 1-.9z" stroke="none" fill={color} />
  )}
  {name === 'youtube' && (
    <>
      <rect x="3" y="6" width="18" height="12" rx="3.5" />
      <path d="M11 9.5l4 2.5-4 2.5z" fill={color} stroke="none" />
    </>
  )}
  {name === 'spotify' && (
    <>
      <circle cx="12" cy="12" r="9.2" />
      <path d="M8 10.4c2.6-.7 5.6-.4 7.8.9M8.4 13.2c2-.5 4.3-.3 6 .8M9 15.7c1.4-.4 2.9-.2 4.1.6" />
    </>
  )}
  {name === 'bandcamp' && (
    <>
      <circle cx="12" cy="12" r="9.2" />
      <path d="M8 14.5l2.4-5h5.6l-2.4 5z" fill={color} stroke="none" />
    </>
  )}
  {name === 'soundcloud' && (
    <>
      <path d="M9 17V9.5c1.8 0 3.3 1.2 3.8 2.9.4-.2.9-.4 1.4-.4 1.7 0 3 1.3 3 3s-1.3 3-3 3H9z" />
      <path d="M6.5 17v-5M4 17v-3.5" />
    </>
  )}
  {name === 'apple' && (
    <>
      <path d="M16 13.2c0-2 1.5-2.9 1.6-3-0.9-1.3-2.2-1.5-2.7-1.5-1.2-0.1-2.2 0.7-2.8 0.7-0.6 0-1.4-0.7-2.4-0.7-1.2 0-2.4 0.7-3 1.8-1.3 2.2-0.3 5.5 0.9 7.3 0.6 0.9 1.3 1.9 2.3 1.8 0.9 0 1.3-0.6 2.4-0.6 1.1 0 1.4 0.6 2.4 0.6 1 0 1.6-0.9 2.2-1.8 0.4-0.6 0.6-1.2 0.8-1.6-1.8-0.7-2.4-2.8-2.4-3.5z" fill={color} stroke="none" />
      <path d="M14.4 7.1c0.5-0.6 0.8-1.5 0.7-2.4-0.7 0-1.6 0.5-2.1 1.1-0.5 0.5-0.9 1.4-0.8 2.3 0.8 0.1 1.6-0.4 2.2-1z" fill={color} stroke="none" />
    </>
  )}
  {name === 'play' && <path d="M8 5.5l11 6.5-11 6.5z" fill={color} stroke="none" />}
  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'chevron' && <path d="M9 6l6 6-6 6" />}
  {name === 'mail' && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="2.5" />
      <path d="M4 7l8 6 8-6" />
    </>
  )}
  {name === 'calendar' && (
    <>
      <rect x="3" y="4.5" width="18" height="16.5" rx="2.2" />
      <path d="M3 9.5h18M8 2.5v4M16 2.5v4" />
    </>
  )}
  {name === 'star' && <path d="M12 3.5l1.2 5.3 5.3 1.2-5.3 1.2L12 16.5l-1.2-5.3L5.5 10l5.3-1.2z" fill={color} stroke="none" />}
  {name === 'cart' && (
    <>
      <path d="M5 5h2l1.6 9.5a1.5 1.5 0 0 0 1.5 1.3h6.8a1.5 1.5 0 0 0 1.5-1.2l1.1-6H7" />
      <circle cx="10" cy="19.5" r="1.2" fill={color} stroke="none" />
      <circle cx="17" cy="19.5" r="1.2" fill={color} stroke="none" />
    </>
  )}
  {name === 'disc' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <circle cx="12" cy="12" r="3.4" />
      <circle cx="12" cy="12" r="0.8" fill={color} stroke="none" />
    </>
  )}
  {name === 'download' && <path d="M12 4v10M8 11l4 4 4-4M5 19h14" />}
  {name === 'quote' && (
    <path d="M9 7H5v5h3v-1c0 1.5-.6 2.4-2 3l.6 1.2C9 14.3 10 12.7 10 10V8a1 1 0 0 0-1-1zm9 0h-4v5h3v-1c0 1.5-.6 2.4-2 3l.6 1.2c2.4-1 3.4-2.6 3.4-5.4V8a1 1 0 0 0-1-1z" fill={color} stroke="none" />
  )}
  {name === 'search' && (
    <>
      <circle cx="11" cy="11" r="7" />
      <path d="M16.5 16.5L21 21" />
    </>
  )}
  {name === 'filter' && <path d="M4 6h16M7 12h10M10 18h4" />}
  {name === 'ticket' && (
    <>
      <path d="M4 8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2 2 2 0 0 0 0 4 2 2 0 0 1-2 2H6a2 2 0 0 1-2-2 2 2 0 0 0 0-4z" />
      <path d="M14 6.4v11.2" stroke-dasharray="2 2" />
    </>
  )}
  {name === 'shirt' && <path d="M8.5 4l-4.5 3 2 3.2 2-1.2V20h8V9l2 1.2 2-3.2L15.5 4a3.5 3.5 0 0 1-7 0z" />}
  {name === 'tag' && (
    <>
      <path d="M4 4h7l9 9-7 7-9-9z" />
      <circle cx="8" cy="8" r="1.4" fill={color} stroke="none" />
    </>
  )}
  {name === 'pin' && (
    <>
      <path d="M12 21s7-6.3 7-11a7 7 0 1 0-14 0c0 4.7 7 11 7 11z" />
      <circle cx="12" cy="10" r="2.6" />
    </>
  )}
  {name === 'external' && (
    <>
      <path d="M14 4h6v6" />
      <path d="M20 4l-9 9" />
      <path d="M19 14v5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
    </>
  )}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
  {name === 'minus' && <path d="M5 12h14" />}
  {name === 'check' && <path d="M5 12l4.5 4.5L19 6" />}
  {name === 'camera' && (
    <>
      <path d="M4 8a2 2 0 0 1 2-2h2l1.5-2h5L18 6h0a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z" />
      <circle cx="12" cy="12.5" r="3.4" />
    </>
  )}
  {name === 'clock' && (
    <>
      <circle cx="12" cy="12" r="8.5" />
      <path d="M12 7v5l3.5 2" />
    </>
  )}
  {name === 'users' && (
    <>
      <circle cx="9" cy="8.5" r="3" />
      <path d="M3.5 19a5.5 5.5 0 0 1 11 0" />
      <path d="M16 6.2a3 3 0 0 1 0 5.6" />
      <path d="M17 13.6a5.5 5.5 0 0 1 3.5 5.4" />
    </>
  )}
  {name === 'info' && (
    <>
      <circle cx="12" cy="12" r="8.5" />
      <path d="M12 11v5" />
      <circle cx="12" cy="7.8" r="1" fill={color} stroke="none" />
    </>
  )}
</svg>
