---
import type { Locale } from '@/types/shared'
import { getSiteConfig, getBandProfile } from '@/lib/cms'
import { merchCopy, siteCopy } from '@/lib/copy'
import { getSlugMap } from '@/lib/slugs'
import MobileNav from './MobileNav.vue'
import CartIcon from './CartIcon.vue'

interface Props {
  lang?: Locale
}
const { lang = 'en' } = Astro.props

const [siteConfig, slugMap, profile] = await Promise.all([
  getSiteConfig(lang),
  getSlugMap(),
  getBandProfile(lang).catch(() => null),
])

// The brand is the profile's name, not a literal. Fail-open like BaseLayout's
// <title> suffix — but a home link with no text and no accessible name is a
// broken header, not a missing suffix, so an unreadable profile falls back to
// the site-wide "Home" label rather than an empty anchor.
const site = siteCopy(siteConfig, lang)
const brand = profile?.name?.trim() || site.homeLink
const cartLabel = merchCopy(siteConfig, lang).cartOpen

const MODULE_SLUGS = ['concerts', 'releases', 'posts', 'photos', 'videos', 'press', 'merch', 'epk', 'about', 'contact'] as const

const orderedSlugs = siteConfig.module_order.length > 0
  ? siteConfig.module_order
  : MODULE_SLUGS.slice()

const moduleLinks = orderedSlugs
  .filter(s => MODULE_SLUGS.includes(s as typeof MODULE_SLUGS[number]) && siteConfig.modules[s] !== false)
  .map(s => ({
    href: `/${lang}/${slugMap[lang][s] ?? s}`,
    label: siteConfig.module_config[s]?.label ?? s,
    module: s,
  }))

const links = moduleLinks

const current = Astro.url.pathname
---

<header class="ss-header">
  <div class="ss-header-inner">
    <a href={`/${lang}`} class="ss-logo" aria-label={site.homeLink}>{brand}</a>

    <nav class="ss-desktop-nav" aria-label={site.navLabel}>
      {links.map(({ href, label }) => (
        current.startsWith(href)
          ? <span class="ss-nav-link is-active" aria-current="page">{label}</span>
          : <a href={href} class="ss-nav-link">{label}</a>
      ))}
    </nav>

    <div class="ss-header-right">
      <CartIcon client:idle label={cartLabel} />
      <MobileNav links={links} brand={brand} copy={{ open: site.menuOpen, close: site.menuClose, navLabel: site.mobileNavLabel }} client:idle />
    </div>
  </div>
</header>

<style>
  .ss-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--color-inverse);
    color: var(--color-on-inverse);
  }
  .ss-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 20px var(--page-gutter);
    flex-wrap: nowrap;
  }

  .ss-logo {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: var(--display-weight);
    letter-spacing: var(--display-tracking);
    text-transform: var(--display-transform);
    line-height: 1;
    color: var(--color-on-inverse);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    transition: color .12s;
  }
  .ss-logo:hover { color: var(--color-accent); }

  .ss-desktop-nav {
    display: none;
    align-items: center;
    gap: 20px;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 14px;
    line-height: 1;
    letter-spacing: .08em;
    text-transform: uppercase;
    flex: 1;
    justify-content: flex-end;
  }
  @media (min-width: 1024px) {
    .ss-desktop-nav { display: flex; }
  }

  .ss-nav-link {
    color: var(--color-on-inverse);
    text-decoration: none;
    white-space: nowrap;
    transition: color .12s;
    cursor: pointer;
  }
  a.ss-nav-link:hover { color: color-mix(in oklab, var(--color-on-inverse) 55%, transparent); }
  span.ss-nav-link.is-active { color: var(--color-accent); }

  .ss-header-right {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  @media (max-width: 1100px) {
    .ss-header-inner { padding: 20px calc(var(--page-gutter) * 0.45); }
  }
  @media (max-width: 600px) {
    .ss-header-inner { padding: 18px calc(var(--page-gutter) * 0.25); }
    .ss-logo { font-size: 18px; }
  }
</style>
