---
import type { Locale } from '@/types/shared'
import { getSiteConfig } from '@/lib/cms'
import { getSlugMap } from '@/lib/slugs'
import MobileNav from './MobileNav.vue'
import CartIcon from './CartIcon.vue'

interface Props {
  lang?: Locale
}
const { lang = 'en' } = Astro.props

const [siteConfig, slugMap] = await Promise.all([
  getSiteConfig(lang),
  getSlugMap(),
])

const MODULE_SLUGS = ['concerts', 'releases', 'posts', 'photos', 'videos', 'press', 'merch', 'epk'] as const

const orderedSlugs = siteConfig.module_order.length > 0
  ? siteConfig.module_order
  : MODULE_SLUGS.slice()

const moduleLinks = orderedSlugs
  .filter(s => MODULE_SLUGS.includes(s as typeof MODULE_SLUGS[number]) && siteConfig.modules[s] !== false)
  .map(s => ({
    href: `/${lang}/${slugMap[lang][s] ?? s}`,
    label: siteConfig.module_config[s]?.label ?? s,
    module: s,
  }))

const links = [
  ...moduleLinks,
  { href: `/${lang}/${slugMap[lang].contact}`, label: lang === 'pl' ? 'Kontakt' : 'Contact', module: null },
]

const current = Astro.url.pathname
---

<header class="ss-header">
  <div class="ss-header-inner">
    <a href={`/${lang}`} class="ss-logo">Skanking Storks</a>

    <nav class="ss-desktop-nav" aria-label="Main navigation">
      {links.map(({ href, label }) => (
        current.startsWith(href)
          ? <span class="ss-nav-link is-active" aria-current="page">{label}</span>
          : <a href={href} class="ss-nav-link">{label}</a>
      ))}
    </nav>

    <div class="ss-header-right">
      <CartIcon client:idle />
      <MobileNav links={links} client:idle />
    </div>
  </div>
</header>

<style>
  .ss-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: #121212;
    color: #EFE7D6;
  }
  .ss-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 20px 90px;
    flex-wrap: nowrap;
  }

  .ss-logo {
    font-family: 'Anton', 'Impact', sans-serif;
    font-size: 22px;
    line-height: 1;
    color: #EFE7D6;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    transition: color .12s;
  }
  .ss-logo:hover { color: #1F8F7A; }

  .ss-desktop-nav {
    display: none;
    align-items: center;
    gap: 20px;
    font-family: 'Archivo', system-ui, sans-serif;
    font-weight: 700;
    font-size: 14px;
    line-height: 1;
    letter-spacing: .08em;
    text-transform: uppercase;
    flex: 1;
    justify-content: flex-end;
  }
  @media (min-width: 1024px) {
    .ss-desktop-nav { display: flex; }
  }

  .ss-nav-link {
    color: #EFE7D6;
    text-decoration: none;
    white-space: nowrap;
    transition: color .12s;
    cursor: pointer;
  }
  a.ss-nav-link:hover { color: rgba(239,231,214,.55); }
  span.ss-nav-link.is-active { color: #1F8F7A; }

  .ss-header-right {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  @media (max-width: 1100px) {
    .ss-header-inner { padding: 20px 40px; }
  }
  @media (max-width: 600px) {
    .ss-header-inner { padding: 18px 20px; }
    .ss-logo { font-size: 18px; }
  }
</style>
