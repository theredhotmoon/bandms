---
import type { Locale } from '@/types/shared'
import { LOCALES, flag, htmlLang, nativeName, type Alternates } from '@/lib/locales'

interface Props {
  lang: Locale
  alternates?: Alternates
}

const { lang, alternates = {} } = Astro.props
const currentHref = Astro.url.pathname

/**
 * One entry per registered locale, built from the route's own map.
 *
 * The previous version rendered a hardcoded English/Polish pair and sent BOTH
 * of them to the same `alternateHref`, so with a third locale two options would
 * have pointed at the same page. A locale with no path in the map is dropped
 * rather than linked to a guess.
 */
const options = LOCALES.flatMap(l => {
  const href = alternates[l] ?? (l === lang ? currentHref : undefined)
  return href ? [{ locale: l, href }] : []
})
---

{options.length > 1 && (
  <div class="lang-selector" aria-label="Language selector">
    {options.map(({ locale, href }, i) => (
      <>
        {i > 0 && <span class="lang-sep" aria-hidden="true">·</span>}
        <a
          href={href}
          class:list={['lang-option', { 'is-active': locale === lang }]}
          aria-current={locale === lang ? 'true' : undefined}
          hreflang={htmlLang(locale)}
        >
          {`${flag(locale)} ${nativeName(locale)}`}
        </a>
      </>
    ))}
  </div>
)}

<style>
  .lang-selector {
    display: flex;
    align-items: center;
    gap: 8px;
    font: 700 11px/1 var(--font-body);
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .lang-option {
    color: inherit;
    text-decoration: none;
    opacity: 0.5;
    transition: opacity .15s;
  }
  .lang-option:hover { opacity: 1; }
  .lang-option.is-active {
    opacity: 1;
    cursor: default;
    pointer-events: none;
  }
  .lang-sep { opacity: 0.3; }
</style>
