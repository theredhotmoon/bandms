{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@bandms/concert-core": [
        "../packages/concert-core/src/index.ts"
      ],
      "@bandms/rider-core": [
        "../packages/rider-core/src/index.ts"
      ],
      "@bandms/rider-core/*": [
        "../packages/rider-core/src/*"
      ],
      "@bandms/site-copy": [
        "../packages/site-copy/src/index.ts"
      ]
    }
  }
}
