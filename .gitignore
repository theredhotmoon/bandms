# The repo is a pnpm workspace (see /pnpm-workspace.yaml): app/, web/ and
# packages/* install together from one root lockfile. A *nested*
# pnpm-workspace.yaml inside a member is what pnpm 10+ leaves behind when it
# asks about build scripts, and it makes that member look like its own
# workspace root — so keep both members free of one. The `allowBuilds` answers
# belong in the root file instead.
/app/pnpm-workspace.yaml
/web/pnpm-workspace.yaml

# Workspace installs hoist to a root node_modules; members and packages keep
# their own for anything unhoistable.
/node_modules
/packages/*/node_modules

# Playwright MCP scratch output (page snapshots, screenshots, console logs)
/.playwright-mcp/

# Never commit private keys. Note `.pub` here is a *private* key despite the
# name: `ssh-keygen -f .pub` writes the private key to `.pub` and the public
# one to `.pub.pub`. Keys belong in ~/.ssh — these rules are a backstop so a
# stray `git add .` cannot publish one.
/.pub
/.pub.pub
*.pem
id_rsa
id_ed25519
