# Copy this to /opt/bandms/.env on the server and fill in every value.
# This file is read by `docker compose -f docker-compose.prod.yml`, which is the
# ONLY way these reach the backend — the service takes no env_file, so anything
# not also listed in the compose file's `environment:` block never arrives.
# See CLAUDE.md, "Setting a backend env var in .env alone does nothing".

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=BandMS
# Generate with: openssl rand -base64 32   → prefix the result with "base64:"
APP_KEY=base64:GENERATE_ME
# The public origin, exactly as visitors type it — scheme, host, no trailing slash.
APP_URL=http://YOUR_SERVER_IP
# Pin to a commit SHA to roll back; "latest" tracks whatever main last pushed.
APP_VERSION=latest
LOG_LEVEL=warning

# ── Caddy / TLS ──────────────────────────────────────────────────────────────
# ":80"  → plain HTTP on the bare IP (no certificate possible without a name)
# "example.com" → Caddy fetches and renews a Let's Encrypt certificate itself
SITE_ADDRESS=:80

# ── Public URLs ──────────────────────────────────────────────────────────────
# CORS allowed origin + every link in outgoing email. Must match APP_URL.
FRONTEND_URL=http://YOUR_SERVER_IP
# Read ONLY by config/services.php to build Stripe's success_url / cancel_url.
# A separate variable from FRONTEND_URL, with a localhost:5173 fallback — leave
# it unset and paying customers are redirected to a host that does not exist.
APP_FRONTEND_URL=http://YOUR_SERVER_IP
# Canonical URL baked into the Astro sitemap and <link rel=canonical>.
SITE_URL=http://YOUR_SERVER_IP

# ── Database ─────────────────────────────────────────────────────────────────
DB_DATABASE=bandms
DB_USERNAME=bandms
DB_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_ANOTHER_STRONG_PASSWORD

# ── Drivers — database is fine for a single-server setup ─────────────────────
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database

# ── Security ─────────────────────────────────────────────────────────────────
# Login attempts per minute, per IP. This is what makes credential stuffing
# expensive. Only meaningful because the app trusts Caddy's X-Forwarded-For
# (bootstrap/app.php) — without that it would be one global bucket.
LOGIN_RATE_LIMIT=10

# ── First admin ──────────────────────────────────────────────────────────────
# LEAVE BOTH BLANK IN PRODUCTION. The seeder creates an admin only when they are
# set; on a fresh server create the account interactively instead, so the
# password is never written to a file:
#   docker exec -it bandms-backend php artisan bandms:create-admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Mail ─────────────────────────────────────────────────────────────────────
# Defaults to "log", which silently discards newsletter confirmations, the
# contact form and rig confirmation requests. Set this to "smtp" and fill in the
# rest. Do NOT try to send directly from the Hetzner IP: outbound port 25 is
# blocked on new accounts and the address block has a poor sending reputation.
#
# Gmail works and needs no domain, which makes it the practical choice before
# you have one: host smtp.gmail.com, port 587, username the full address, and
# an App Password (NOT the account password — requires 2-Step Verification, at
# myaccount.google.com/apppasswords). The cap is ~500 recipients/day, fine for
# the contact form but something a growing newsletter will outgrow.
MAIL_MAILER=smtp
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
# Leave EMPTY for STARTTLS on port 587. Laravel maps an empty value to "smtp",
# or to "smtps" when the port is 465, before building the mailer DSN. Any value
# you do set is passed through untouched to Symfony's EsmtpTransportFactory,
# which supports exactly ["smtp", "smtps"] and throws UnsupportedSchemeException
# for anything else. "tls" looks plausible and is what most tutorials show, and
# it fails on the first send — not at deploy, when you would notice.
MAIL_SCHEME=
MAIL_USERNAME=
MAIL_PASSWORD=
# Gmail and most providers rewrite From: to the authenticating account, so this
# normally has to match MAIL_USERNAME or a verified alias.
MAIL_FROM_ADDRESS=hello@yourdomain.com
# The band's name — fans see this as the sender. Not the software's name.
MAIL_FROM_NAME="Your Band Name"
# Where contact-form submissions land.
CONTACT_EMAIL=hello@yourdomain.com
# MX lookup on subscriber addresses. Leave true in production.
NEWSLETTER_VERIFY_MX=true

# ── Stripe ───────────────────────────────────────────────────────────────────
# Start with test keys (sk_test_…), verify a full purchase, then swap to live.
STRIPE_SECRET_KEY=
# From the Stripe dashboard webhook endpoint pointing at
# {APP_URL}/api/webhooks/stripe — the signing secret, starting whsec_.
STRIPE_WEBHOOK_SECRET=

# ── Optional API integrations (leave blank to disable) ───────────────────────
YOUTUBE_API_KEY=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
SETLISTFM_API_KEY=

# ── Public site (web/, Astro) ─────────────────────────────────────────────────
# These are read by the `web` container at STARTUP (astro build runs in
# start.sh, not at image-build time), so unlike the admin's VITE_* vars below,
# setting them here is enough — no CI rebuild needed. Recreate to apply:
#   docker compose -f docker-compose.prod.yml up -d --no-deps web
#
# Which theme the public site renders under. Empty = plain black-and-white base.
PUBLIC_THEME=skanking-storks
# CARTO basemap key for the concert/venue maps. Not a secret — it's a public,
# domain-scoped credential (see web/src/lib/basemap.ts) — but leaving it blank
# watermarks every map tile "API KEY REQUIRED". Get one free at
# https://carto.com/basemaps/apikey (emailed instantly, no approval queue).
# NOTE: this does NOT reach the admin panel's venue map — that's a separate,
# build-time value; see PUBLIC_CARTO_KEY under "Repository secrets" in
# docs/deployment.md.
PUBLIC_CARTO_KEY=
# GA4 Measurement ID (starts with "G-"). Blank disables the consent banner and
# GA entirely — see web/src/stores/consent.ts.
PUBLIC_GA_MEASUREMENT_ID=
